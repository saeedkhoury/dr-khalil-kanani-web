# Copy to .env and fill. Never commit .env.

# Lead store. Without these the form endpoint returns 503 and logs loudly
# rather than silently discarding a patient enquiry.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Local preview only. Bypasses the launch gate so the site builds while clinic
# facts are still unverified. NEVER set this in CI or production.
# VERIFY_RELAX=1
