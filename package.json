{
  "name": "dr-khalilkanani",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:admin": "VISUAL_CMS=1 ASTRO_SITE=https://admin.drkhalilkanani.com astro build",
    "build:preview": "VERIFY_RELAX=1 astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:claims": "node --experimental-strip-types scripts/lint-claims.ts",
    "lint:scripts": "node scripts/lint-mixed-scripts.mjs",
    "lint:data": "node --experimental-strip-types scripts/lint-data.ts",
    "verify": "npm run lint:claims && npm run lint:scripts && npm run lint:data && npm run lint:assets:full && npm run check",
    "astro": "astro",
    "lint:assets": "node scripts/check-assets.mjs",
    "lint:assets:full": "node scripts/check-assets.mjs --full",
    "prepare": "git config core.hooksPath .githooks",
    "test": "node --experimental-strip-types --test \"tests/unit/*.test.ts\"",
    "test:watch": "node --experimental-strip-types --test --watch \"tests/unit/*.test.ts\"",
    "lint:a11y": "node scripts/audit-html.mjs",
    "test:e2e": "playwright test",
    "verify:same-site": "node scripts/compare-admin-public.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "jose": "^6.2.12",
    "motion": "^13.4.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
