{
  "name": "dr-khalilkanani",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "VERIFY_RELAX=1 astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:claims": "node scripts/lint-claims.mjs",
    "lint:scripts": "node scripts/lint-mixed-scripts.mjs",
    "verify": "npm run lint:claims && npm run lint:scripts && npm run lint:assets && npm run check",
    "astro": "astro",
    "lint:assets": "node scripts/check-assets.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "test": "node --experimental-strip-types --test \"tests/unit/*.test.ts\"",
    "test:watch": "node --experimental-strip-types --test --watch \"tests/unit/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "motion": "^13.4.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
