---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TreatmentsGrid from '../../../components/sections/TreatmentsGrid.astro';
import ContactCta from '../../../components/sections/ContactCta.astro';
import { LOCALES, localizePath, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { getTreatments } from '../../../lib/content';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const treatments = await getTreatments(locale);

const description = {
  he: 'הטיפולים הניתנים במרפאה בג׳דיידה-מכר: השתלות, טיפולי שורש, ציפויים, קשתיות שקופות, הלבנה וטיפולי חירום.',
  ar: 'العلاجات المتوفرة في العيادة في الجديدة-المكر: زراعة، علاج عصب، قشور، تقويم شفاف، تبييض وعلاجات طوارئ.',
  en: 'Treatments available at the clinic in Jadeidi-Makr: implants, root canal, veneers, clear aligners, whitening and emergency care.',
}[locale];

const breadcrumbs = [
  { name: t('nav.home'), path: localizePath(locale, '') },
  { name: t('nav.treatments'), path: localizePath(locale, 'treatments') },
];
---

<BaseLayout locale={locale} title={t('treatments.title')} description={description} breadcrumbs={breadcrumbs}>
  <TreatmentsGrid locale={locale} treatments={treatments} headingLevel="h1" />
  <ContactCta locale={locale} />
</BaseLayout>
