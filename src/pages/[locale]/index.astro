---
/**
 * Homepage.
 *
 * Section order deviates deliberately from a conventional clinic layout:
 * TREATMENTS sit above the doctor introduction. Visitors arrive with a need,
 * not with curiosity about the dentist; the doctor converts after they have
 * confirmed the clinic does the thing they came for.
 *
 * There is no reviews section and no before/after gallery. Both are
 * prohibited for Israeli dentists — patient identities and photographs may
 * not be used in advertising. See docs/decisions/0005 and 0006.
 *
 * PatientFeedback is NOT a testimonials block: it links out to the clinic's
 * Google profile, where the patient publishes, and carries no names, quotes
 * or ratings. It renders only once a profile URL is supplied.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import TreatmentsGrid from '../../components/sections/TreatmentsGrid.astro';
import DoctorIntro from '../../components/sections/DoctorIntro.astro';
import FaqAccordion from '../../components/sections/FaqAccordion.astro';
import ClinicGallery from '../../components/sections/ClinicGallery.astro';
import PatientFeedback from '../../components/sections/PatientFeedback.astro';
import FindTheClinic from '../../components/sections/FindTheClinic.astro';

import { LOCALES, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getTreatments } from '../../lib/content';
import { generalFaq } from '../../data/faq';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
const treatments = await getTreatments(locale);
const faq = generalFaq.slice(0, 5).map((f) => ({ q: f.q[locale], a: f.a[locale] }));
---

<BaseLayout locale={locale} title={t('site.title')} description={t('hero.subtitle')}>
  <Hero locale={locale} />
  <TrustStrip locale={locale} />
  <TreatmentsGrid locale={locale} treatments={treatments} limit={6} />
  <DoctorIntro locale={locale} />
  <ClinicGallery locale={locale} kind="work" />
  <PatientFeedback locale={locale} />
  <FaqAccordion locale={locale} items={faq} id="home-faq" />
  <FindTheClinic locale={locale} />
</BaseLayout>
