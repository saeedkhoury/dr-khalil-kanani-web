 * wordmark exists in Hebrew only, so pairing the mark with localised HTML
 * text is what lets the same identity work in all three languages.
 *
 * `mono` renders it in currentColor for use on dark or tinted surfaces.
 */
interface Props {
  size?: number;
  mono?: boolean;
  class?: string;
}
