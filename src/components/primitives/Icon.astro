---
/**
 * Inline SVG icon set. No icon fonts, no emoji, no external requests.
 *
 * Icons are decorative by default (aria-hidden) — the adjacent text carries
 * the meaning. Pass `title` only when an icon is the sole content of a
 * control, which then makes it an accessible graphic rather than noise.
 *
 * Directional glyphs (chevron, arrow) carry the `u-flip` class so they
 * mirror under RTL. Logos, the phone handset and clock do NOT mirror.
 */
interface Props {
  name: string;
  size?: number;
  title?: string;
  class?: string;
  stroke?: number;
}

const { name, size = 24, title, class: className = '', stroke = 1.6 } = Astro.props;

