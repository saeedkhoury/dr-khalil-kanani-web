---
/**
 * Appointment request form — emails the clinic, falls back to WhatsApp.
 *
 * The request is POSTed to a Cloudflare Worker which emails it to the clinic
 * (see workers/appointment-email/). WhatsApp is the FALLBACK, used when the
 * relay is unreachable or unconfigured — never silently, and never while
 * telling the patient something different happened.
 *
 * ── WHY THERE IS A WHATSAPP FALLBACK AT ALL (ADR 0007) ────────────────────
 * The site is hosted on GitHub Pages, which is static-only. The build's server
 * route lands in `dist/server/` and is never deployed — the workflow uploads
 * `dist/client`. The previous version posted to `/api/appointment-request/`,
 * which returns 405 in production, so EVERY request submitted on the live site
 * was silently lost.
 *
 * The form now composes the entered details into a WhatsApp message addressed
 * to the clinic's verified mobile and hands off to it. The request reaches the
 * dentist directly, on the channel Israelis actually use, with no server, no
 * database and no third party.
 *
 * Privacy consequence, deliberately: nothing is stored by this site at all.
 * That removes the Amendment 13 database duties entirely — no retention
 * policy, no deletion path, no consent-version record to keep. The inline
 * notice says so plainly rather than implying a server that does not exist.
 *
 * Marketing opt-in was REMOVED: there is no list to add anyone to and no store
 * to record the consent in, so asking for it would have been theatre.
 *
 * Accessibility is unchanged from the server version:
 *  · real <label> on every field, never a placeholder
 *  · inline errors tied to fields via aria-describedby
 *  · focusable error summary on failed submit, links to each invalid field
 *  · errors announced (role="alert") and identified in text, not colour
 *  · phone uses type="tel" + inputmode + autocomplete
 *
 * Without JavaScript the form cannot compose a message, so a <noscript> block
 * offers the two direct channels instead. Nothing is hidden from those users.
 */
import { type Locale, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { CONTACT_METHODS, DAYPARTS } from '../../lib/form-options';
import { clinic, telUrl, whatsappUrl } from '../../data/clinic';
import type { Treatment } from '../../lib/content';
import Icon from '../primitives/Icon.astro';

interface Props {
  locale: Locale;
  treatments: Treatment[];
  /** Preselect when the form is embedded on a treatment page. */
  preselect?: string;
}

const { locale, treatments, preselect = '' } = Astro.props;
const t = useTranslations(locale);

const fallbackWa = whatsappUrl(
  {
    he: 'שלום, אשמח לקבוע תור במרפאה.',
    ar: 'مرحبًا، أودّ حجز موعد في العيادة.',
    en: 'Hello, I would like to request an appointment.',
  }[locale],
);

const fieldBase =
  'mt-1.5 block w-full min-h-[44px] rounded-[var(--radius-field)] border border-[var(--color-line-strong)] ' +
  'bg-[var(--color-porcelain)] px-3.5 py-2.5 text-[var(--text-base)] text-[var(--color-body)] ' +
  'transition-[border-color] duration-[var(--dur-fast)] focus:border-[var(--color-ink)]';

const labelBase = 'block text-[var(--text-sm)] font-semibold text-[var(--color-ink)]';
const errorBase = 'mt-1.5 flex items-start gap-1.5 text-[var(--text-sm)] text-[var(--color-danger)]';
---

<form
  id="appointment-form"
  novalidate
  data-wa-number={clinic.phone.mobile.whatsapp}
  data-heading={t('form.messageHeading')}
  data-endpoint={clinic.requestEndpoint}
  data-locale={locale}
  class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-porcelain)] p-6 sm:p-8"
>
  <h2 class="text-[var(--text-xl)] font-semibold">{t('form.title')}</h2>
  <p class="mt-2 text-[var(--text-sm)] text-[var(--color-muted)]">{t('form.intro')}</p>

  <noscript>
    <div class="mt-5 rounded-[var(--radius-field)] border border-[var(--color-line-strong)] bg-[var(--color-mist)] p-4">
      <p class="text-[var(--text-sm)]">{t('form.noJs')}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a
          href={telUrl('landline')}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-ink)] px-5 font-semibold text-white no-underline"
        >
          <Icon name="phone" size={18} />
          <span class="u-ltr">{clinic.phone.landline.display}</span>
        </a>
        <a
          href={fallbackWa}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-wa)] px-5 font-semibold text-white no-underline"
        >
          <Icon name="whatsapp" size={18} />
          <span>{t('action.whatsapp')}</span>
        </a>
      </div>
    </div>
  </noscript>

  <!-- Error summary: hidden until a failed submit, then focused. -->
  <div
    id="error-summary"
    role="alert"
    tabindex="-1"
    hidden
    class="mt-6 rounded-[var(--radius-field)] border border-[var(--color-danger)] bg-white p-4"
  >
    <h3 id="error-summary-title" class="text-[var(--text-base)] font-semibold text-[var(--color-danger)]">
      {t('form.error.summaryTitle')}
    </h3>
    <ul id="error-summary-list" class="mt-2 space-y-1" style="padding-inline-start:1.1rem"></ul>
  </div>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    <!-- Name -->
    <div class="sm:col-span-1">
      <label class={labelBase} for="f-name">
        {t('form.name')} <span aria-hidden="true">*</span>
        <span class="sr-only">({t('form.required')})</span>
      </label>
      <input
        id="f-name"
        name="name"
        type="text"
        required
        autocomplete="name"
        maxlength="80"
        class={fieldBase}
        data-label={t('msg.name')}
      />
      <p id="f-name-error" class={`${errorBase} invisible`} aria-hidden="true">
        <Icon name="alert" size={16} />
        <span>{t('form.error.name')}</span>
      </p>
    </div>

    <!-- Phone -->
    <div class="sm:col-span-1">
      <label class={labelBase} for="f-phone">
        {t('form.phone')} <span aria-hidden="true">*</span>
        <span class="sr-only">({t('form.required')})</span>
      </label>
      <input
        id="f-phone"
        name="phone"
        type="tel"
        required
        inputmode="tel"
        autocomplete="tel"
        dir="ltr"
        maxlength="20"
        class={`${fieldBase} u-ltr`}
        data-label={t('msg.phone')}
      />
      <p id="f-phone-error" class={`${errorBase} invisible`} aria-hidden="true">
        <Icon name="alert" size={16} />
        <span>{t('form.error.phone')}</span>
      </p>
    </div>

    <!-- Contact method -->
    <fieldset
      class="sm:col-span-2"
      style="border:0;padding:0;margin:0"
      data-label={t('msg.contact')}
    >
      <legend class={labelBase}>{t('form.contactMethod')}</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        {
          CONTACT_METHODS.map((m, i) => (
            <label class="inline-flex min-h-[44px] cursor-pointer items-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-line-strong)] px-4 transition-colors duration-[var(--dur-fast)] has-[:checked]:border-[var(--color-ink)] has-[:checked]:bg-[var(--color-mist)]">
              <input type="radio" name="contactMethod" value={m} checked={i === 0} class="accent-[var(--color-ink)]" />
              <span class="text-[var(--text-sm)]">{t(`form.contactMethod.${m}` as never)}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <!-- Treatment -->
    <div class="sm:col-span-1">
      <label class={labelBase} for="f-treatment">
        {t('form.treatment')}
        <span class="font-normal text-[var(--color-muted)]">({t('form.optional')})</span>
      </label>
      <select id="f-treatment" name="treatment" class={fieldBase} data-label={t('msg.treatment')}>
        <option value="">{t('form.treatment.none')}</option>
        {
          treatments.map((item) => (
            <option value={item.data.slug} selected={item.data.slug === preselect}>
              {item.data.cardTitle}
            </option>
          ))
        }
      </select>
    </div>

    <!-- Daypart -->
    <div class="sm:col-span-1">
      <label class={labelBase} for="f-daypart">
        {t('form.daypart')}
        <span class="font-normal text-[var(--color-muted)]">({t('form.optional')})</span>
      </label>
      <select id="f-daypart" name="daypart" class={fieldBase} data-label={t('msg.daypart')}>
        {
          DAYPARTS.map((d) => (
            <option value={d} selected={d === 'any'}>
              {t(`form.daypart.${d}` as never)}
            </option>
          ))
        }
      </select>
    </div>

    <!-- Message -->
    <div class="sm:col-span-2">
      <label class={labelBase} for="f-message">{t('form.message')}</label>
      <textarea
        id="f-message"
        name="message"
        rows="3"
        maxlength="500"
        class={fieldBase}
        aria-describedby="f-message-hint"
        data-label={t('msg.note')}></textarea>
      <p id="f-message-hint" class="mt-1.5 text-[var(--text-sm)] text-[var(--color-muted)]">
        {t('form.messageHint')}
      </p>
    </div>
  </div>

  {/* ── Honeypot ──────────────────────────────────────────────────────────
      Off-screen rather than display:none — some bots skip hidden inputs but
      almost all fill anything with a plausible name. aria-hidden and
      tabindex=-1 keep it away from screen readers and the tab order.

      THE NAME MATTERS. This was `name="company"` with autocomplete="off",
      and Chrome autofilled it anyway — browsers ignore that hint on standard
      address-form names. A real patient's request was silently discarded
      while the page told them it had been sent.

      `hp_ref2` matches no autofill heuristic. The label is gone for the same
      reason: a visible-to-the-browser label saying "Company" is itself a
      strong autofill signal. */}
  <div aria-hidden="true" style="position:absolute;inset-inline-start:-9999px;width:1px;height:1px;overflow:hidden">
    <input
      type="text"
      id="f-hp-ref2"
      name="hp_ref2"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
  </div>

  <!-- Consent: unticked, never bundled with the submit action. -->
  <div class="mt-7 border-t border-[var(--color-line)] pt-6">
    <label class="flex cursor-pointer items-start gap-3">
      <input
        type="checkbox"
        name="consent"
        id="f-consent"
        required
        value="true"
        class="mt-1 size-5 shrink-0 accent-[var(--color-ink)]"
      />
      <span class="text-[var(--text-sm)] leading-relaxed">
        {t('form.consent')} <span aria-hidden="true">*</span>
      </span>
    </label>
    <p id="f-consent-error" class={`${errorBase} invisible`} aria-hidden="true">
      <Icon name="alert" size={16} />
      <span>{t('form.error.consent')}</span>
    </p>
  </div>

  <!-- What actually happens, stated plainly at the point of collection. -->
  <p class="mt-5 flex items-start gap-2 rounded-[var(--radius-field)] bg-[var(--color-mist)] p-4 text-[var(--text-sm)] leading-relaxed text-[var(--color-muted)]">
    <Icon name="whatsapp" size={17} class="mt-0.5 shrink-0 text-[var(--color-wa)]" />
    <span>{t('form.handoffNote')}</span>
  </p>

  <details class="mt-3 rounded-[var(--radius-field)] bg-[var(--color-mist)] p-4">
    <summary class="cursor-pointer text-[var(--text-sm)] font-semibold text-[var(--color-ink)]">
      {t('privacy.notice.title')}
    </summary>
    <p class="mt-2 text-[var(--text-sm)] leading-relaxed text-[var(--color-muted)]">
      {t('privacy.notice.body')}
    </p>
    <p class="mt-2">
      <a href={localizePath(locale, 'privacy')} class="text-[var(--text-sm)] font-semibold">
        {t('privacy.readPolicy')}
      </a>
    </p>
  </details>

  <button
    type="submit"
    id="f-submit"
    data-submitting={t('form.submitting')}
    class="mt-6 inline-flex min-h-[48px] w-full cursor-pointer items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-ink)] px-7 font-semibold text-white transition-[background-color,transform] duration-[var(--dur-fast)] ease-[var(--ease-out)] hover:bg-[var(--color-ink-deep)] active:translate-y-px disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
  >
    {/* Deliberately NOT a WhatsApp mark. The request is emailed; WhatsApp is
        only the fallback, and a green WhatsApp button promised a channel the
        form no longer uses by default. */}
    <Icon name="mail" size={19} />
    <span data-label>{t('form.submit')}</span>
  </button>

  <p id="f-generic-error" class={`${errorBase} mt-4`} hidden>
    <Icon name="alert" size={16} />
    <span>{t('form.error.generic')}</span>
  </p>
</form>

<!-- Success state replaces the form once the request has actually gone.
     It carries BOTH wordings because the two delivery paths are genuinely
     different events: an emailed request is finished, whereas a WhatsApp
     handoff still needs the patient to press send. Telling someone "sent"
     when they must still act — or "press send" when it already went — is the
     kind of small lie that loses an appointment. -->
<div
  id="form-success"
  role="status"
  tabindex="-1"
  hidden
  data-sent-title={t('form.success.title')}
  data-sent-body={t('form.success.body')}
  data-wa-title={t('form.success.waTitle')}
  data-wa-body={t('form.success.waBody')}
  class="rounded-[var(--radius-card)] border border-[var(--color-line-strong)] bg-[var(--color-mist)] p-8"
>
  <span class="flex size-11 items-center justify-center rounded-full bg-[var(--color-ink)] text-white">
    <Icon name="check" size={22} stroke={2.4} />
  </span>
  <h2 id="form-success-title" class="mt-4 text-[var(--text-xl)] font-semibold">{t('form.success.title')}</h2>
  <p id="form-success-body" class="mt-2 text-[var(--color-muted)]">{t('form.success.body')}</p>
  <p class="mt-5">
    <a
      href={telUrl('landline')}
      class="inline-flex min-h-[44px] items-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-line-strong)] px-5 font-semibold text-[var(--color-ink)] no-underline hover:bg-[var(--color-porcelain)]"
    >
      <Icon name="phone" size={18} />
      <span class="u-ltr">{clinic.phone.landline.display}</span>
    </a>
  </p>
</div>

<script>
  // Zero-dependency phone helpers. Importing from lib/validation would pull
  // Zod into the browser (measured: +85KB).
  import { IL_PHONE, normalisePhone } from '../../lib/phone';

  const form = document.getElementById('appointment-form') as HTMLFormElement | null;
  if (form) {
    const summary = document.getElementById('error-summary')!;
    const summaryList = document.getElementById('error-summary-list')!;
    const success = document.getElementById('form-success')!;
    const genericError = document.getElementById('f-generic-error')!;
    // When the form became interactive. A submit faster than a human could
    // type is treated as a bot by the relay.
    const startedAt = Date.now();

    /**
     * True while a submission is in flight.
     *
     * Disabling the button is not sufficient by itself: a fast double-click
     * can dispatch two submit events before the first handler runs, and the
     * dentist would get the same request twice with no way to tell.
     */
    let submitting = false;

    const submitBtn = document.getElementById('f-submit') as HTMLButtonElement;
    const submitLabel = submitBtn.querySelector('[data-label]') as HTMLElement;

    const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    type Check = { id: string; valid: () => boolean };
    const checks: Check[] = [
      { id: 'f-name', valid: () => el<HTMLInputElement>('f-name').value.trim().length >= 2 },
      { id: 'f-phone', valid: () => IL_PHONE.test(normalisePhone(el<HTMLInputElement>('f-phone').value)) },
      { id: 'f-consent', valid: () => el<HTMLInputElement>('f-consent').checked },
    ];

    function setFieldError(id: string, invalid: boolean) {
      const field = document.getElementById(id)!;
      const error = document.getElementById(`${id}-error`);
      field.setAttribute('aria-invalid', invalid ? 'true' : 'false');
      if (invalid) field.setAttribute('aria-describedby', `${id}-error`);
      else field.removeAttribute('aria-describedby');
      // Reserve the error's space: blur runs between pointer-down and click,
      // so collapsing it can move the next control out from under the pointer.
      if (error) {
        error.classList.toggle('invisible', !invalid);
        error.setAttribute('aria-hidden', invalid ? 'false' : 'true');
      }
    }

    // Validate on blur, not on every keystroke.
    for (const check of checks) {
      const node = document.getElementById(check.id)!;
      const event = node.getAttribute('type') === 'checkbox' ? 'change' : 'blur';
      node.addEventListener(event, () => setFieldError(check.id, !check.valid()));
    }

    /**
     * Everything the visitor entered, read once.
     *
     * Both delivery paths derive from this single read, so the email and the
     * WhatsApp message can never disagree about what was submitted — which
     * would be a genuinely nasty bug to diagnose from a complaint.
     *
     * Selects carry DISPLAY TEXT, not slugs: the dentist reads words, and a
     * value of "root-canal" in an inbox is worse than useless.
     */
    function readEntry() {
      const name = el<HTMLInputElement>('f-name');
      const phone = el<HTMLInputElement>('f-phone');
      const treatment = el<HTMLSelectElement>('f-treatment');
      const daypart = el<HTMLSelectElement>('f-daypart');
      const note = el<HTMLTextAreaElement>('f-message');
      const methodField = form!.querySelector('fieldset') as HTMLFieldSetElement;
      const method = form!.querySelector<HTMLInputElement>('input[name="contactMethod"]:checked');
      const honeypot = el<HTMLInputElement>('f-hp-ref2');

      return {
        fields: [
          { label: name.dataset.label, value: name.value, key: 'name' },
          { label: phone.dataset.label, value: phone.value, key: 'phone' },
          {
            label: methodField.dataset.label,
            value: method?.closest('label')?.textContent?.trim() ?? '',
            key: 'contactMethod',
          },
          {
            label: treatment.dataset.label,
            value: treatment.value ? (treatment.selectedOptions[0]?.text ?? '') : '',
            key: 'treatment',
          },
          { label: daypart.dataset.label, value: daypart.selectedOptions[0]?.text ?? '', key: 'daypart' },
          { label: note.dataset.label, value: note.value, key: 'message' },
        ],
        honeypot: honeypot?.value ?? '',
      };
    }

    /** The WhatsApp message — used as the primary path, and as the fallback. */
    function composeMessage(): string {
      const lines: string[] = [form!.dataset.heading ?? '', ''];
      for (const f of readEntry().fields) {
        if (f.label && f.value.trim()) lines.push(`${f.label}: ${f.value.trim()}`);
      }
      return lines.join('\n');
    }

    /** The JSON the relay Worker receives. Same data, different shape. */
    function composePayload(): Record<string, unknown> {
      const entry = readEntry();
      const payload: Record<string, unknown> = {
        locale: form!.dataset.locale ?? '',
        hp_ref2: entry.honeypot,
        elapsedMs: Date.now() - startedAt,
        consent: !!(document.getElementById('f-consent') as HTMLInputElement | null)?.checked,
      };
      for (const f of entry.fields) payload[f.key] = f.value.trim();
      return payload;
    }

    /** Hand off to WhatsApp. The original behaviour, now also the fallback. */
    function handOffToWhatsApp() {
      const url = `https://wa.me/${form!.dataset.waNumber}?text=${encodeURIComponent(composeMessage())}`;

      // Opening in a new tab keeps the site (and the success state) available.
      // If a popup blocker intervenes, navigate in place instead — never leave
      // the visitor with a dead button.
      // noopener makes window.open return null even when the tab opens, so a
      // blank same-origin tab is opened first to make popup detection
      // meaningful, then its opener is severed before navigating.
      const opened = window.open('', '_blank');
      if (!opened) {
        window.location.href = url;
        return false;
      }
      opened.opener = null;
      const referrer = opened.document.createElement('meta');
      referrer.name = 'referrer';
      referrer.content = 'no-referrer';
      opened.document.head.appendChild(referrer);
      opened.location.replace(url);
      return true;
    }

    /**
     * @param via 'email' when the relay confirmed delivery, 'whatsapp' when we
     * fell back. The panel must describe the event that actually occurred.
     */
    function showSuccess(via: 'email' | 'whatsapp') {
      const title = document.getElementById('form-success-title')!;
      const body = document.getElementById('form-success-body')!;
      const d = success.dataset;
      title.textContent = (via === 'email' ? d.sentTitle : d.waTitle) ?? title.textContent;
      body.textContent = (via === 'email' ? d.sentBody : d.waBody) ?? body.textContent;
      form!.hidden = true;
      success.hidden = false;
      success.focus();
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (submitting) return;
      genericError.hidden = true;

      const failed = checks.filter((c) => !c.valid());
      checks.forEach((c) => setFieldError(c.id, !c.valid()));

      if (failed.length > 0) {
        summaryList.innerHTML = '';
        for (const f of failed) {
          const msg = document.getElementById(`${f.id}-error`)?.textContent?.trim() ?? '';
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${f.id}`;
          a.textContent = msg;
          a.addEventListener('click', (e) => {
            e.preventDefault();
            document.getElementById(f.id)?.focus();
          });
          li.appendChild(a);
          summaryList.appendChild(li);
        }
        summary.hidden = false;
        summary.focus();
        return;
      }

      summary.hidden = true;
      submitting = true;
      submitBtn.disabled = true;
      const original = submitLabel.textContent;
      submitLabel.textContent = submitBtn.dataset.submitting ?? original;

      const restore = () => {
        submitting = false;
        submitBtn.disabled = false;
        if (original) submitLabel.textContent = original;
      };

      const endpoint = form.dataset.endpoint ?? '';

      // ── No relay configured ───────────────────────────────────────────
      // The original behaviour, unchanged. An unconfigured endpoint must
      // mean "use WhatsApp", never "drop the request".
      if (!endpoint) {
        if (handOffToWhatsApp()) showSuccess('whatsapp');
        restore();
        return;
      }

      // ── Relay configured: email first, WhatsApp on failure ────────────
      // The site lost every enquiry once because a submit path failed
      // silently in production (ADR 0007). So the failure branch is not an
      // afterthought here: any non-success answer, including a network error
      // or a timeout, falls through to the channel that is known to work.
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 8000);

      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(composePayload()),
        signal: controller.signal,
      })
        .then((response) => (response.ok ? response.json() : Promise.reject(new Error(String(response.status)))))
        .then((body) => {
          if (!body || body.ok !== true) throw new Error('relay_rejected');
          showSuccess('email');
        })
        .catch(() => {
          // Deliberately quiet toward the visitor: they get a working path,
          // not an explanation of our infrastructure. The request still
          // reaches the dentist.
          if (handOffToWhatsApp()) showSuccess('whatsapp');
          else genericError.hidden = false;
        })
        .finally(() => {
          clearTimeout(timeout);
          restore();
        });
    });
  }
</script>
