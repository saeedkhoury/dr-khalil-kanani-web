---
/**
 * Appointment request form — WhatsApp handoff.
 *
 * ── WHY THIS IS NOT A SERVER POST (ADR 0007) ──────────────────────────────
 * The site is hosted on GitHub Pages, which is static-only. The build's server
 * route lands in `dist/server/` and is never deployed — the workflow uploads
 * `dist/client`. The previous version posted to `/api/appointment-request/`,
 * which returns 405 in production, so EVERY request submitted on the live site
 * was silently lost.
 *
 * The form now composes the entered details into a WhatsApp message addressed
 * to the clinic's verified mobile and hands off to it. The request reaches the
 * dentist directly, on the channel Israelis actually use, with no server, no
 * database and no third party.
 *
 * Privacy consequence, deliberately: nothing is stored by this site at all.
 * That removes the Amendment 13 database duties entirely — no retention
 * policy, no deletion path, no consent-version record to keep. The inline
 * notice says so plainly rather than implying a server that does not exist.
 *
 * Marketing opt-in was REMOVED: there is no list to add anyone to and no store
 * to record the consent in, so asking for it would have been theatre.
 *
 * Accessibility is unchanged from the server version:
 *  · real <label> on every field, never a placeholder
 *  · inline errors tied to fields via aria-describedby
 *  · focusable error summary on failed submit, links to each invalid field
 *  · errors announced (role="alert") and identified in text, not colour
 *  · phone uses type="tel" + inputmode + autocomplete
 *
 * Without JavaScript the form cannot compose a message, so a <noscript> block
 * offers the two direct channels instead. Nothing is hidden from those users.
 */
import { type Locale, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { CONTACT_METHODS, DAYPARTS } from '../../lib/form-options';
import { clinic, telUrl, whatsappUrl } from '../../data/clinic';
import type { Treatment } from '../../lib/content';
import Icon from '../primitives/Icon.astro';

interface Props {
  locale: Locale;
  treatments: Treatment[];
  /** Preselect when the form is embedded on a treatment page. */
  preselect?: string;
}

const { locale, treatments, preselect = '' } = Astro.props;
const t = useTranslations(locale);

const fallbackWa = whatsappUrl(
  {
    he: 'שלום, אשמח לקבוע תור במרפאה.',
    ar: 'مرحبًا، أودّ حجز موعد في العيادة.',
    en: 'Hello, I would like to request an appointment.',
  }[locale],
);

const fieldBase =
  'mt-1.5 block w-full min-h-[44px] rounded-[var(--radius-field)] border border-[var(--color-line-strong)] ' +
  'bg-[var(--color-porcelain)] px-3.5 py-2.5 text-[var(--text-base)] text-[var(--color-body)] ' +
  'transition-[border-color] duration-[var(--dur-fast)] focus:border-[var(--color-ink)]';

const labelBase = 'block text-[var(--text-sm)] font-semibold text-[var(--color-ink)]';
const errorBase = 'mt-1.5 flex items-start gap-1.5 text-[var(--text-sm)] text-[var(--color-danger)]';
---

<form
  id="appointment-form"
  novalidate
  data-wa-number={clinic.phone.mobile.whatsapp}
  data-heading={t('form.messageHeading')}
  class="rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-porcelain)] p-6 sm:p-8"
>
  <h2 class="text-[var(--text-xl)] font-semibold">{t('form.title')}</h2>
  <p class="mt-2 text-[var(--text-sm)] text-[var(--color-muted)]">{t('form.intro')}</p>

  <noscript>
    <div class="mt-5 rounded-[var(--radius-field)] border border-[var(--color-line-strong)] bg-[var(--color-mist)] p-4">
      <p class="text-[var(--text-sm)]">{t('form.noJs')}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a
          href={telUrl('landline')}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-ink)] px-5 font-semibold text-white no-underline"
        >
          <Icon name="phone" size={18} />
          <span class="u-ltr">{clinic.phone.landline.display}</span>
        </a>
        <a
          href={fallbackWa}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-wa)] px-5 font-semibold text-white no-underline"
        >
          <Icon name="whatsapp" size={18} />
          <span>{t('action.whatsapp')}</span>
        </a>
      </div>
    </div>
  </noscript>

  <!-- Error summary: hidden until a failed submit, then focused. -->
  <div
    id="error-summary"
    role="alert"
    tabindex="-1"
    hidden
    class="mt-6 rounded-[var(--radius-field)] border border-[var(--color-danger)] bg-white p-4"
  >
    <h3 id="error-summary-title" class="text-[var(--text-base)] font-semibold text-[var(--color-danger)]">
      {t('form.error.summaryTitle')}
    </h3>
    <ul id="error-summary-list" class="mt-2 space-y-1" style="padding-inline-start:1.1rem"></ul>
  </div>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    <!-- Name -->
    <div class="sm:col-span-1">
      <label class={labelBase} for="f-name">
        {t('form.name')} <span aria-hidden="true">*</span>
        <span class="sr-only">({t('form.required')})</span>
      </label>
      <input
        id="f-name"
        name="name"
        type="text"
        required
        autocomplete="name"
        maxlength="80"
        class={fieldBase}
        aria-describedby="f-name-error"
        data-label={t('msg.name')}
      />
      <p id="f-name-error" class={errorBase} hidden>
        <Icon name="alert" size={16} />
        <span>{t('form.error.name')}</span>
      </p>
    </div>

    <!-- Phone -->
    <div class="sm:col-span-1">
      <label class={labelBase} for="f-phone">
        {t('form.phone')} <span aria-hidden="true">*</span>
        <span class="sr-only">({t('form.required')})</span>
      </label>
      <input
        id="f-phone"
        name="phone"
        type="tel"
        required
        inputmode="tel"
        autocomplete="tel"
        dir="ltr"
        maxlength="20"
        class={`${fieldBase} u-ltr`}
        aria-describedby="f-phone-error"
        data-label={t('msg.phone')}
      />
      <p id="f-phone-error" class={errorBase} hidden>
        <Icon name="alert" size={16} />
        <span>{t('form.error.phone')}</span>
      </p>
    </div>

    <!-- Contact method -->
    <fieldset
      class="sm:col-span-2"
      style="border:0;padding:0;margin:0"
      data-label={t('msg.contact')}
    >
      <legend class={labelBase}>{t('form.contactMethod')}</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        {
          CONTACT_METHODS.map((m, i) => (
            <label class="inline-flex min-h-[44px] cursor-pointer items-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-line-strong)] px-4 transition-colors duration-[var(--dur-fast)] has-[:checked]:border-[var(--color-ink)] has-[:checked]:bg-[var(--color-mist)]">
              <input type="radio" name="contactMethod" value={m} checked={i === 0} class="accent-[var(--color-ink)]" />
              <span class="text-[var(--text-sm)]">{t(`form.contactMethod.${m}` as never)}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <!-- Treatment -->
    <div class="sm:col-span-1">
      <label class={labelBase} for="f-treatment">
        {t('form.treatment')}
        <span class="font-normal text-[var(--color-muted)]">({t('form.optional')})</span>
      </label>
      <select id="f-treatment" name="treatment" class={fieldBase} data-label={t('msg.treatment')}>
        <option value="">{t('form.treatment.none')}</option>
        {
          treatments.map((item) => (
            <option value={item.data.slug} selected={item.data.slug === preselect}>
              {item.data.cardTitle}
            </option>
          ))
        }
      </select>
    </div>

    <!-- Daypart -->
    <div class="sm:col-span-1">
      <label class={labelBase} for="f-daypart">
        {t('form.daypart')}
        <span class="font-normal text-[var(--color-muted)]">({t('form.optional')})</span>
      </label>
      <select id="f-daypart" name="daypart" class={fieldBase} data-label={t('msg.daypart')}>
        {
          DAYPARTS.map((d) => (
            <option value={d} selected={d === 'any'}>
              {t(`form.daypart.${d}` as never)}
            </option>
          ))
        }
      </select>
    </div>

    <!-- Message -->
    <div class="sm:col-span-2">
      <label class={labelBase} for="f-message">{t('form.message')}</label>
      <textarea
        id="f-message"
        name="message"
        rows="3"
        maxlength="500"
        class={fieldBase}
        aria-describedby="f-message-hint"
        data-label={t('msg.note')}></textarea>
      <p id="f-message-hint" class="mt-1.5 text-[var(--text-sm)] text-[var(--color-muted)]">
        {t('form.messageHint')}
      </p>
    </div>
  </div>

  <!-- Consent: unticked, never bundled with the submit action. -->
  <div class="mt-7 border-t border-[var(--color-line)] pt-6">
    <label class="flex cursor-pointer items-start gap-3">
      <input
        type="checkbox"
        name="consent"
        id="f-consent"
        required
        value="true"
        class="mt-1 size-5 shrink-0 accent-[var(--color-ink)]"
        aria-describedby="f-consent-error"
      />
      <span class="text-[var(--text-sm)] leading-relaxed">
        {t('form.consent')} <span aria-hidden="true">*</span>
      </span>
    </label>
    <p id="f-consent-error" class={errorBase} hidden>
      <Icon name="alert" size={16} />
      <span>{t('form.error.consent')}</span>
    </p>
  </div>

  <!-- What actually happens, stated plainly at the point of collection. -->
  <p class="mt-5 flex items-start gap-2 rounded-[var(--radius-field)] bg-[var(--color-mist)] p-4 text-[var(--text-sm)] leading-relaxed text-[var(--color-muted)]">
    <Icon name="whatsapp" size={17} class="mt-0.5 shrink-0 text-[var(--color-wa)]" />
    <span>{t('form.handoffNote')}</span>
  </p>

  <details class="mt-3 rounded-[var(--radius-field)] bg-[var(--color-mist)] p-4">
    <summary class="cursor-pointer text-[var(--text-sm)] font-semibold text-[var(--color-ink)]">
      {t('privacy.notice.title')}
    </summary>
    <p class="mt-2 text-[var(--text-sm)] leading-relaxed text-[var(--color-muted)]">
      {t('privacy.notice.body')}
    </p>
    <p class="mt-2">
      <a href={localizePath(locale, 'privacy')} class="text-[var(--text-sm)] font-semibold">
        {t('privacy.readPolicy')}
      </a>
    </p>
  </details>

  <button
    type="submit"
    id="f-submit"
    data-submitting={t('form.submitting')}
    class="mt-6 inline-flex min-h-[48px] w-full cursor-pointer items-center justify-center gap-2 rounded-[var(--radius-btn)] bg-[var(--color-wa)] px-7 font-semibold text-white transition-[filter,transform] duration-[var(--dur-fast)] ease-[var(--ease-out)] hover:brightness-90 active:translate-y-px disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
  >
    <Icon name="whatsapp" size={19} />
    <span data-label>{t('form.submit')}</span>
  </button>

  <p id="f-generic-error" class={`${errorBase} mt-4`} hidden>
    <Icon name="alert" size={16} />
    <span>{t('form.error.generic')}</span>
  </p>
</form>

<!-- Success state replaces the form once WhatsApp has been handed off to. -->
<div
  id="form-success"
  role="status"
  tabindex="-1"
  hidden
  class="rounded-[var(--radius-card)] border border-[var(--color-wa)] bg-[var(--color-mist)] p-8"
>
  <span class="flex size-11 items-center justify-center rounded-full bg-[var(--color-wa)] text-white">
    <Icon name="check" size={22} stroke={2.4} />
  </span>
  <h2 class="mt-4 text-[var(--text-xl)] font-semibold">{t('form.success.title')}</h2>
  <p class="mt-2 text-[var(--color-muted)]">{t('form.success.body')}</p>
  <p class="mt-5">
    <a
      href={telUrl('landline')}
      class="inline-flex min-h-[44px] items-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-line-strong)] px-5 font-semibold text-[var(--color-ink)] no-underline hover:bg-[var(--color-porcelain)]"
    >
      <Icon name="phone" size={18} />
      <span class="u-ltr">{clinic.phone.landline.display}</span>
    </a>
  </p>
</div>

<script>
  // Zero-dependency phone helpers. Importing from lib/validation would pull
  // Zod into the browser (measured: +85KB).
  import { IL_PHONE, normalisePhone } from '../../lib/phone';

  const form = document.getElementById('appointment-form') as HTMLFormElement | null;
  if (form) {
    const summary = document.getElementById('error-summary')!;
    const summaryList = document.getElementById('error-summary-list')!;
    const success = document.getElementById('form-success')!;
    const genericError = document.getElementById('f-generic-error')!;
    const submitBtn = document.getElementById('f-submit') as HTMLButtonElement;
    const submitLabel = submitBtn.querySelector('[data-label]') as HTMLElement;

    const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    type Check = { id: string; valid: () => boolean };
    const checks: Check[] = [
      { id: 'f-name', valid: () => el<HTMLInputElement>('f-name').value.trim().length >= 2 },
      { id: 'f-phone', valid: () => IL_PHONE.test(normalisePhone(el<HTMLInputElement>('f-phone').value)) },
      { id: 'f-consent', valid: () => el<HTMLInputElement>('f-consent').checked },
    ];

    function setFieldError(id: string, invalid: boolean) {
      const field = document.getElementById(id)!;
      const error = document.getElementById(`${id}-error`);
      field.setAttribute('aria-invalid', invalid ? 'true' : 'false');
      if (error) error.hidden = !invalid;
    }

    // Validate on blur, not on every keystroke.
    for (const check of checks) {
      const node = document.getElementById(check.id)!;
      const event = node.getAttribute('type') === 'checkbox' ? 'change' : 'blur';
      node.addEventListener(event, () => setFieldError(check.id, !check.valid()));
    }

    /** Build the message the dentist actually receives. */
    function composeMessage(): string {
      const lines: string[] = [form!.dataset.heading ?? '', ''];

      const add = (label: string | undefined, value: string) => {
        if (label && value.trim()) lines.push(`${label}: ${value.trim()}`);
      };

      const name = el<HTMLInputElement>('f-name');
      const phone = el<HTMLInputElement>('f-phone');
      const treatment = el<HTMLSelectElement>('f-treatment');
      const daypart = el<HTMLSelectElement>('f-daypart');
      const note = el<HTMLTextAreaElement>('f-message');
      const methodField = form!.querySelector('fieldset') as HTMLFieldSetElement;
      const method = form!.querySelector<HTMLInputElement>('input[name="contactMethod"]:checked');
      const methodLabel = method?.closest('label')?.textContent?.trim() ?? '';


      add(name.dataset.label, name.value);
      add(phone.dataset.label, phone.value);
      add(methodField.dataset.label, methodLabel);
      // Selects carry display text, not slugs — the dentist reads words.
      if (treatment.value) add(treatment.dataset.label, treatment.selectedOptions[0]?.text ?? '');
      add(daypart.dataset.label, daypart.selectedOptions[0]?.text ?? '');
      add(note.dataset.label, note.value);

      return lines.join('\n');
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      genericError.hidden = true;

      const failed = checks.filter((c) => !c.valid());
      checks.forEach((c) => setFieldError(c.id, !c.valid()));

      if (failed.length > 0) {
        summaryList.innerHTML = '';
        for (const f of failed) {
          const msg = document.getElementById(`${f.id}-error`)?.textContent?.trim() ?? '';
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${f.id}`;
          a.textContent = msg;
          a.addEventListener('click', (e) => {
            e.preventDefault();
            document.getElementById(f.id)?.focus();
          });
          li.appendChild(a);
          summaryList.appendChild(li);
        }
        summary.hidden = false;
        summary.focus();
        return;
      }

      summary.hidden = true;
      submitBtn.disabled = true;
      const original = submitLabel.textContent;
      submitLabel.textContent = submitBtn.dataset.submitting ?? original;

      const url = `https://wa.me/${form.dataset.waNumber}?text=${encodeURIComponent(composeMessage())}`;

      // Opening in a new tab keeps the site (and the success state) available.
      // If a popup blocker intervenes, navigate in place instead — never leave
      // the visitor with a dead button.
      // noopener makes window.open return null even when the tab opens.
      // Open a blank same-origin tab first so popup detection is meaningful,
      // then sever its opener before navigating to WhatsApp.
      const opened = window.open('', '_blank');
      if (!opened) {
        window.location.href = url;
        return;
      }
      opened.opener = null;
      const referrer = opened.document.createElement('meta');
      referrer.name = 'referrer';
      referrer.content = 'no-referrer';
      opened.document.head.appendChild(referrer);
      opened.location.replace(url);

      form.hidden = true;
      success.hidden = false;
      success.focus();
      submitBtn.disabled = false;
      if (original) submitLabel.textContent = original;
    });
  }
</script>
