---
/** Compact identity, navigation and legal footer. Contact details live on the contact page. */
import { localizePath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { clinic } from '../../data/clinic';
import Logo from '../primitives/Logo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const nav = [
  { key: 'nav.about', path: 'about' },
  { key: 'nav.treatments', path: 'treatments' },
  { key: 'nav.faq', path: 'faq' },
  { key: 'nav.contact', path: 'contact' },
] as const;

const legal = [
  { key: 'legal.accessibility', path: 'accessibility' },
  { key: 'legal.privacy', path: 'privacy' },
] as const;

---

<footer class="mt-8 border-t border-[var(--color-line)] bg-[var(--color-mist)]">
  <div class="shell grid gap-10 py-12 sm:grid-cols-2">
    <!-- Identity -->
    <div class="lg:col-span-1">
      <div class="flex items-center gap-2.5">
        <Logo size={40} />
        <span class="leading-tight">
          <span class="block font-semibold text-[var(--color-ink)]">{clinic.doctor[locale]}</span>
          <span class="block text-[var(--text-sm)] text-[var(--color-muted)]">{clinic.tagline[locale]}</span>
        </span>
      </div>
      <p class="mt-4 text-[var(--text-sm)] text-[var(--color-muted)]">
        {clinic.address.locality[locale]}
      </p>
    </div>

    <!-- Navigate -->
    <nav aria-labelledby="footer-nav-heading">
      <h2 id="footer-nav-heading" class="eyebrow mb-3">{t('nav.menu')}</h2>
      <ul class="space-y-1.5" style="list-style:none;padding-inline-start:0;margin:0">
        {
          nav.map((item) => (
            <li>
              <a
                href={localizePath(locale, item.path)}
                class="text-[var(--text-sm)] text-[var(--color-body)] no-underline hover:underline"
              >
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

  </div>

  <!-- Legal -->
  <div class="border-t border-[var(--color-line)]">
    <div class="shell flex flex-col gap-3 py-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[var(--text-xs)] text-[var(--color-muted)]">
        © <span class="u-ltr">{year}</span> {clinic.doctor[locale]}. {t('footer.rights')}.
      </p>
      <ul class="flex flex-wrap gap-4" style="list-style:none;padding-inline-start:0;margin:0">
        {
          legal.map((item) => (
            <li>
              <a
                href={localizePath(locale, item.path)}
                class="text-[var(--text-xs)] text-[var(--color-muted)] no-underline hover:underline"
              >
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    {/* pb-20 keeps the accessibility button's default corner
        (AccessibilityControl) clear of this last line at the page's end. */}
    <div class="shell pb-20">
      <p class="text-[var(--text-xs)] leading-relaxed text-[var(--color-muted)]">
        {t('legal.disclaimer')}
      </p>
      {/* The studio credit, the footer's last line: English in every locale, so it is
          isolated left-to-right (.u-ltr) and set in the English face on every page. */}
      <p class="mt-3 text-[var(--text-xs)] uppercase tracking-[0.08em] text-[var(--color-muted)]">
        <a
          href="https://skova.dev"
          target="_blank"
          rel="noopener"
          lang="en"
          class="u-ltr text-[var(--color-muted)] underline underline-offset-[3px] [font-family:var(--font-en,system-ui,sans-serif)] hover:text-[var(--color-ink)]"
          >Developed by ©SKOVA<span class="sr-only"> (opens in a new tab)</span></a
        >
      </p>
    </div>
  </div>
</footer>
