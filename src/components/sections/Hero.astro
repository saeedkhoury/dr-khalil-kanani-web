---
/**
 * Hero.
 *
 * Answers, in order: WHERE (eyebrow), WHAT (h1), WHO + WHY (subtitle), and
 * WHAT NEXT (actions). It does not open with a biography — one reference site
 * does, and its H1 is a 450-character paragraph as a result.
 *
 * ── TWO STATES, BOTH DELIBERATE ───────────────────────────────────────────
 * WITH a photograph: split composition, image bleeding to the inline edge.
 * WITHOUT one: a TYPOGRAPHIC hero — the display type becomes the subject,
 * over a layered tinted field, with the clinic's real facts as the supporting
 * structure.
 *
 * The previous version put the logo mark in concentric boxes, which read as
 * "assets pending". A typographic hero is a choice a designer makes on
 * purpose; an empty image frame is one they were forced into. Since no
 * approved clinic photography exists, and inventing some is prohibited, the
 * honest move is to make type carry the screen.
 *
 * Dropping in the real photo later is a one-line change in src/data/media.ts.
 * Nothing here needs redesigning.
 */
import { Image } from 'astro:assets';
import { localizePath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { clinic, telUrl, whatsappUrl } from '../../data/clinic';
import { heroImage, hasHeroImage } from '../../data/media';
import { resolveImage } from '../../lib/images';
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const waMessage = {
  he: 'שלום, אשמח לקבוע תור במרפאה.',
  ar: 'مرحبًا، أودّ حجز موعد في العيادة.',
  en: 'Hello, I would like to request an appointment.',
}[locale];

// Resolve to a real asset. A manifest entry whose file is missing falls back
// to the typographic hero rather than rendering a broken image.
const heroAsset = heroImage ? resolveImage(heroImage.file) : undefined;
const withImage = hasHeroImage() && heroAsset !== undefined;
---

<section
  class="relative overflow-hidden border-b border-[var(--color-line)] bg-[var(--color-porcelain)]"
  aria-labelledby="hero-heading"
>
  <!-- Depth from layered tint, never a shadow. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style="background:
      radial-gradient(64rem 34rem at 82% -12%, var(--color-haze) 0%, transparent 62%),
      radial-gradient(44rem 28rem at 4% 108%, var(--color-mist) 0%, transparent 68%);"
  >
  </div>

  <div
    class:list={[
      'shell grid items-center gap-10 py-16 md:py-24',
      withImage ? 'lg:grid-cols-[1fr_0.92fr] lg:gap-16' : 'lg:gap-14',
    ]}
  >
    <div class={withImage ? '' : 'max-w-4xl'}>
      <p class="eyebrow enter flex items-center gap-1.5" style="--i:0">
        <Icon name="map-pin" size={15} />
        {t('hero.eyebrow')}
      </p>

      <!-- The one display moment on the page. -->
      <h1
        id="hero-heading"
        class="enter mt-4"
        style={`--i:1; font-size:${withImage ? 'var(--text-3xl)' : 'var(--text-display)'}`}
      >
        {t('hero.title')}
      </h1>

      <p
        class="enter mt-6 max-w-xl text-[var(--text-lg)] leading-relaxed text-[var(--color-muted)]"
        style="--i:2"
      >
        {t('hero.subtitle')}
      </p>

      <div class="enter mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--i:3">
        <Button href={localizePath(locale, 'contact')} variant="primary" size="lg" icon="plus">
          {t('action.bookAppointment')}
        </Button>
        <Button
          href={whatsappUrl(waMessage)}
          variant="whatsapp"
          size="lg"
          icon="whatsapp"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('action.whatsapp')}
        </Button>
      </div>

      <!-- The flyer's own call to action is "call now", so the number is
           readable without tapping. Bidi-isolated so it never reorders. -->
      <p class="enter mt-7 text-[var(--text-sm)] text-[var(--color-muted)]" style="--i:4">
        {t('action.callNow')}:{' '}
        <a
          href={telUrl('landline')}
          class="u-ltr font-semibold text-[var(--color-ink)] no-underline hover:underline"
        >
          {clinic.phone.landline.display}
        </a>
      </p>
    </div>

    {
      withImage && heroImage && heroAsset ? (
        <div class="enter relative" style="--i:2">
          <Image
            src={heroAsset}
            alt={heroImage.alt[locale]}
            width={heroImage.width}
            height={heroImage.height}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 46vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="media aspect-[4/3] w-full"
          />
        </div>
      ) : null
    }
  </div>

</section>
