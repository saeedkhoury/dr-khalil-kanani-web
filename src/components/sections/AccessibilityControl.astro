---
/**
 * Accessibility settings: a small button and a native <dialog> panel.
 *
 * NOT an overlay that "fixes" the site — the markup itself is built to IS 5568
 * (see docs and data/legal.ts). This only offers presentation preferences a
 * visitor may want on top of that: larger text, higher contrast, underlined
 * links, no animation. No screen-reader imitation: people who use one bring
 * their own, and a fake one gets in their way.
 *
 * The button is a quiet round 44 px control. It starts in the lower corner
 * (above the phone action bar where there is one) and can be dragged to any
 * height along the left or right edge — it snaps to the nearer side, stays
 * clear of the header and the action bar, and the spot is remembered in this
 * browser (src/lib/a11y-prefs.ts, applied before paint). A press without
 * movement opens the panel; a drag never does. <dialog>.showModal() gives
 * the focus trap, Escape and an inert page for free.
 */
import { localizePath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { PREFS_KEY, FAB_KEY, TEXT_STEPS } from '../../lib/a11y-prefs';
import Icon from '../primitives/Icon.astro';

interface Props {
  locale: Locale;
  /** The phone action bar is shown: start above it, never drop onto it. */
  aboveActionBar: boolean;
}
const { locale, aboveActionBar } = Astro.props;
const t = useTranslations(locale);

const toggles = [
  { key: 'contrast', label: t('a11y.panel.contrast') },
  { key: 'links', label: t('a11y.panel.links') },
  { key: 'motion', label: t('a11y.panel.motion') },
] as const;
---

<button
  type="button"
  class:list={['a11y-fab', aboveActionBar && 'a11y-fab--above-bar']}
  data-a11y-open
  data-fab-key={FAB_KEY}
  aria-haspopup="dialog"
  aria-controls="a11y-panel"
  aria-label={t('a11y.panel.open')}
>
  <Icon name="accessibility" size={24} />
</button>

<dialog
  id="a11y-panel"
  class="a11y-panel"
  aria-labelledby="a11y-panel-title"
  data-prefs-key={PREFS_KEY}
  data-text-steps={JSON.stringify(TEXT_STEPS)}
>
  <div class="a11y-panel-head">
    <h2 id="a11y-panel-title" class="a11y-panel-title">{t('a11y.panel.title')}</h2>
    <button type="button" class="a11y-icon-btn" data-a11y-close aria-label={t('a11y.panel.close')}>
      <Icon name="close" size={20} />
    </button>
  </div>

  <div class="a11y-row" role="group" aria-labelledby="a11y-text-label">
    <span id="a11y-text-label">{t('a11y.panel.text')}</span>
    <span class="a11y-stepper">
      <button type="button" class="a11y-icon-btn" data-a11y-step="-1" aria-label={t('a11y.panel.smaller')}>
        <Icon name="minus" size={20} />
      </button>
      <output class="a11y-value u-ltr" data-a11y-text-value aria-live="polite">100%</output>
      <button type="button" class="a11y-icon-btn" data-a11y-step="1" aria-label={t('a11y.panel.larger')}>
        <Icon name="plus" size={20} />
      </button>
    </span>
  </div>

  {toggles.map((item) => (
    <button type="button" class="a11y-toggle" data-a11y-toggle={item.key} aria-pressed="false">
      <span>{item.label}</span>
      <span class="a11y-switch" aria-hidden="true"><span></span></span>
    </button>
  ))}

  <div class="a11y-panel-foot">
    <button type="button" class="a11y-reset" data-a11y-reset>{t('a11y.panel.reset')}</button>
    <a href={localizePath(locale, 'accessibility')}>{t('legal.accessibility')}</a>
  </div>
  <p class="a11y-note">{t('a11y.panel.note')}</p>
</dialog>

<style>
  .a11y-fab {
    /* The band the button may be dragged within: below the sticky header,
       above the bottom edge (or the phone action bar). */
    --fab-size: 44px;
    --fab-min: 5rem;
    --fab-max: calc(100dvh - var(--fab-size) - 1rem - env(safe-area-inset-bottom, 0px));
    position: fixed;
    z-index: 45;
    inset-block-end: calc(1rem + env(safe-area-inset-bottom, 0px));
    inset-inline-start: max(1rem, env(safe-area-inset-left, 0px), env(safe-area-inset-right, 0px));
    /* A drag must move the button, not scroll the page or open a callout. */
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-porcelain);
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color var(--dur-fast) ease;
  }
  .a11y-fab:hover {
    background: var(--color-mist);
  }
  @media (max-width: 767.98px) {
    .a11y-fab--above-bar {
      --fab-max: calc(100dvh - var(--fab-size) - var(--actionbar-h) - env(safe-area-inset-bottom, 0px) - 0.75rem);
      inset-block-end: calc(var(--actionbar-h) + env(safe-area-inset-bottom, 0px) + 0.75rem);
    }
  }
  /* Where the visitor dragged it: a physical side, a clamped height. */
  :global(html[data-fab-side]) .a11y-fab {
    inset: auto;
    top: clamp(var(--fab-min), calc(var(--fab-y) * 100dvh), var(--fab-max));
  }
  :global(html[data-fab-side='left']) .a11y-fab {
    left: max(0.75rem, env(safe-area-inset-left, 0px));
  }
  :global(html[data-fab-side='right']) .a11y-fab {
    right: max(0.75rem, env(safe-area-inset-right, 0px));
  }
  .a11y-fab.is-dragging {
    cursor: grabbing;
    background: var(--color-mist);
    box-shadow: 0 10px 28px -14px rgba(12, 82, 131, 0.55);
  }

  .a11y-panel {
    inline-size: min(22rem, calc(100vw - 2rem));
    max-block-size: calc(100dvh - 6rem);
    overflow: auto;
    margin: 0;
    inset: auto;
    inset-block-end: calc(4.5rem + env(safe-area-inset-bottom, 0px));
    inset-inline-start: max(1rem, env(safe-area-inset-left, 0px), env(safe-area-inset-right, 0px));
    padding: 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-card);
    background: var(--color-porcelain);
    color: var(--color-body);
    box-shadow: 0 18px 44px -24px rgba(12, 82, 131, 0.45);
  }
  .a11y-panel::backdrop {
    background: rgba(15, 42, 61, 0.18);
  }
  /* Phones: a bottom sheet clear of the home indicator. */
  @media (max-width: 767.98px) {
    .a11y-panel {
      inline-size: 100%;
      max-inline-size: 100%;
      inset-inline: 0;
      inset-block-end: 0;
      border-end-start-radius: 0;
      border-end-end-radius: 0;
      padding-block-end: calc(1rem + env(safe-area-inset-bottom, 0px));
    }
  }

  .a11y-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-end: 0.5rem;
  }
  .a11y-panel-title {
    font-size: var(--text-lg);
    margin: 0;
  }
  .a11y-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 44px;
    min-block-size: 44px;
    border-radius: var(--radius-btn);
    border: 1px solid var(--color-line-strong);
    background: var(--color-porcelain);
    color: var(--color-ink);
    cursor: pointer;
  }
  .a11y-icon-btn:hover:not(:disabled) {
    background: var(--color-mist);
  }
  .a11y-icon-btn:disabled {
    color: var(--color-muted);
    cursor: default;
    opacity: 0.55;
  }

  .a11y-row,
  .a11y-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    inline-size: 100%;
    min-block-size: 52px;
    padding-block: 0.375rem;
    border-block-start: 1px solid var(--color-line);
    font-size: var(--text-base);
    color: var(--color-body);
  }
  .a11y-stepper {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .a11y-value {
    min-inline-size: 3.25rem;
    text-align: center;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .a11y-toggle {
    background: none;
    border-inline: 0;
    border-block-end: 0;
    cursor: pointer;
    text-align: start;
    font: inherit;
  }
  .a11y-toggle:hover {
    background: var(--color-mist);
  }
  .a11y-switch {
    flex: none;
    position: relative;
    inline-size: 2.5rem;
    block-size: 1.5rem;
    border-radius: 999px;
    border: 2px solid var(--color-muted);
    background: var(--color-porcelain);
  }
  .a11y-switch > span {
    position: absolute;
    inset-block-start: 2px;
    inset-inline-start: 2px;
    inline-size: calc(1.5rem - 8px);
    block-size: calc(1.5rem - 8px);
    border-radius: 999px;
    background: var(--color-muted);
  }
  .a11y-toggle[aria-pressed='true'] .a11y-switch {
    border-color: var(--color-ink);
    background: var(--color-ink);
  }
  .a11y-toggle[aria-pressed='true'] .a11y-switch > span {
    inset-inline-start: auto;
    inset-inline-end: 2px;
    background: #fff;
  }

  .a11y-panel-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--color-line);
  }
  .a11y-panel-foot a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    color: var(--color-ink);
    font-weight: 600;
  }
  .a11y-reset {
    min-block-size: 44px;
    padding-inline: 1rem;
    border-radius: var(--radius-btn);
    border: 1px solid var(--color-line-strong);
    background: var(--color-porcelain);
    color: var(--color-ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .a11y-reset:hover {
    background: var(--color-mist);
  }
  .a11y-note {
    margin: 0.5rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>

<script>
  import { parsePrefs, prefAttributes, snapFab, type A11yPrefs, type FabPosition } from '../../lib/a11y-prefs';

  // ── Dragging the button along the side edges ──────────────────────────
  const fab = document.querySelector<HTMLButtonElement>('.a11y-fab');
  const fabKey = fab?.dataset.fabKey ?? '';
  const placeFab = (pos: FabPosition | null): void => {
    const root = document.documentElement;
    if (pos) {
      root.setAttribute('data-fab-side', pos.side);
      root.style.setProperty('--fab-y', String(pos.y));
    } else {
      root.removeAttribute('data-fab-side');
      root.style.removeProperty('--fab-y');
    }
    try {
      if (pos) localStorage.setItem(fabKey, JSON.stringify(pos));
      else localStorage.removeItem(fabKey);
    } catch { /* private mode: it still moves for this page */ }
  };
  if (fab) {
    const DRAG_THRESHOLD = 8;
    const GAP = 12;
    let start: { x: number; y: number; left: number; top: number } | null = null;
    let dragging = false;
    let suppressClick = false;
    let current = { left: 0, top: 0 };

    // Below the sticky header, above the bottom edge or the phone action bar.
    const band = (): { minTop: number; maxTop: number } => {
      const header = document.querySelector('.site-header')?.getBoundingClientRect();
      const barEl = document.querySelector<HTMLElement>('[data-action-bar]');
      const bar = barEl && getComputedStyle(barEl).display !== 'none' ? barEl.getBoundingClientRect() : null;
      const minTop = (header ? Math.max(header.bottom, 0) : 0) + GAP;
      const maxTop = (bar && bar.height ? bar.top : innerHeight) - fab.offsetHeight - GAP;
      return { minTop, maxTop: Math.max(minTop, maxTop) };
    };

    fab.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      const box = fab.getBoundingClientRect();
      start = { x: event.clientX, y: event.clientY, left: box.left, top: box.top };
      dragging = false;
      try { fab.setPointerCapture(event.pointerId); } catch { /* synthetic pointer */ }
    });
    fab.addEventListener('pointermove', (event) => {
      if (!start) return;
      const dx = event.clientX - start.x;
      const dy = event.clientY - start.y;
      if (!dragging && Math.hypot(dx, dy) < DRAG_THRESHOLD) return;
      if (!dragging) {
        dragging = true;
        fab.classList.add('is-dragging');
      }
      const { minTop, maxTop } = band();
      current = {
        left: Math.min(Math.max(start.left + dx, 0), innerWidth - fab.offsetWidth),
        top: Math.min(Math.max(start.top + dy, minTop), maxTop),
      };
      fab.style.inset = 'auto';
      fab.style.left = `${current.left}px`;
      fab.style.top = `${current.top}px`;
    });
    const finish = (commit: boolean): void => {
      if (!start) return;
      start = null;
      if (!dragging) return;
      dragging = false;
      fab.classList.remove('is-dragging');
      fab.removeAttribute('style');
      if (!commit) return;
      const { minTop, maxTop } = band();
      placeFab(snapFab({
        centerX: current.left + fab.offsetWidth / 2,
        top: current.top,
        viewportW: innerWidth,
        viewportH: innerHeight,
        minTop,
        maxTop,
      }));
      // The release that ends a drag also fires a click: swallow that one.
      suppressClick = true;
      window.setTimeout(() => { suppressClick = false; }, 400);
    };
    fab.addEventListener('pointerup', () => finish(true));
    fab.addEventListener('pointercancel', () => finish(false));
    // Capture runs before the open handler below.
    fab.addEventListener('click', (event) => {
      if (!suppressClick) return;
      suppressClick = false;
      event.preventDefault();
      event.stopImmediatePropagation();
    }, true);
  }

  // Focus Not Obscured (WCAG 2.4.11). A focused element can be fully inside
  // the viewport yet under the sticky header or the phone action bar, and
  // browsers do not scroll then — scroll-padding only applies when they do.
  // Nudge it clear of both, so a keyboard user always sees where they are.
  const GAP = 8;
  document.addEventListener('focusin', (event) => {
    const el = event.target;
    if (!(el instanceof HTMLElement) || el.closest('.site-header, [data-action-bar], dialog, .a11y-fab')) return;
    // Keyboard focus only. A mouse or finger press focuses on the way down;
    // scrolling then would move the target before the release and lose the
    // click.
    if (!el.matches(':focus-visible')) return;
    const box = el.getBoundingClientRect();
    if (!box.height) return;
    const header = document.querySelector('.site-header')?.getBoundingClientRect();
    const barEl = document.querySelector<HTMLElement>('[data-action-bar]');
    const bar = barEl && getComputedStyle(barEl).display !== 'none' ? barEl.getBoundingClientRect() : null;
    const top = header ? header.bottom : 0;
    const bottom = bar && bar.height ? bar.top : innerHeight;
    // 'instant': the page scrolls smoothly by default, and focus must not lag.
    if (box.top < top) window.scrollBy({ top: box.top - top - GAP, behavior: 'instant' });
    else if (box.bottom > bottom) window.scrollBy({ top: Math.min(box.bottom - bottom + GAP, box.top - top - GAP), behavior: 'instant' });
  });

  const dialog = document.querySelector<HTMLDialogElement>('#a11y-panel');
  if (dialog) {
    const key = dialog.dataset.prefsKey ?? '';
    const steps: number[] = JSON.parse(dialog.dataset.textSteps ?? '[1]');
    const root = document.documentElement;
    let opener: HTMLElement | null = null;

    const read = (): A11yPrefs => {
      try { return parsePrefs(localStorage.getItem(key)); } catch { return parsePrefs(null); }
    };
    let prefs = read();

    const apply = (): void => {
      for (const name of [...root.getAttributeNames()]) if (name.startsWith('data-a11y-')) root.removeAttribute(name);
      for (const [name, value] of Object.entries(prefAttributes(prefs))) root.setAttribute(name, value);
      try {
        const isDefault = Object.keys(prefAttributes(prefs)).length === 0;
        if (isDefault) localStorage.removeItem(key);
        else localStorage.setItem(key, JSON.stringify(prefs));
      } catch { /* private mode: the choice still applies to this page */ }
      render();
    };

    const value = dialog.querySelector<HTMLOutputElement>('[data-a11y-text-value]');
    const smaller = dialog.querySelector<HTMLButtonElement>('[data-a11y-step="-1"]');
    const larger = dialog.querySelector<HTMLButtonElement>('[data-a11y-step="1"]');
    const render = (): void => {
      if (value) value.textContent = `${Math.round(steps[prefs.text] * 100)}%`;
      if (smaller) smaller.disabled = prefs.text === 0;
      if (larger) larger.disabled = prefs.text === steps.length - 1;
      dialog.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((button) => {
        const name = button.dataset.a11yToggle as 'contrast' | 'links' | 'motion';
        button.setAttribute('aria-pressed', String(prefs[name]));
      });
    };

    dialog.querySelectorAll<HTMLButtonElement>('[data-a11y-step]').forEach((button) => {
      button.addEventListener('click', () => {
        const next = prefs.text + Number(button.dataset.a11yStep);
        prefs = { ...prefs, text: Math.max(0, Math.min(steps.length - 1, next)) };
        apply();
        // A disabled button drops focus to <body>; keep the visitor in place.
        if (button.disabled) (button === smaller ? larger : smaller)?.focus();
      });
    });
    dialog.querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const name = button.dataset.a11yToggle as 'contrast' | 'links' | 'motion';
        prefs = { ...prefs, [name]: !prefs[name] };
        apply();
      });
    });
    dialog.querySelector('[data-a11y-reset]')?.addEventListener('click', () => {
      prefs = parsePrefs(null);
      apply();
      placeFab(null); // the button returns to its corner too
    });

    const close = (): void => dialog.close();
    dialog.querySelector('[data-a11y-close]')?.addEventListener('click', close);
    // A click on the backdrop lands on the <dialog> itself.
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    dialog.addEventListener('close', () => {
      document.querySelectorAll('[data-a11y-open]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      opener?.focus();
    });

    document.querySelectorAll<HTMLElement>('[data-a11y-open]').forEach((button) => {
      button.setAttribute('aria-expanded', 'false');
      button.addEventListener('click', () => {
        opener = button;
        prefs = read();
        render();
        dialog.showModal();
        button.setAttribute('aria-expanded', 'true');
      });
    });
    render();
  }
</script>
