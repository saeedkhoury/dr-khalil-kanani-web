---
/**
 * FAQ accordion — native <details>/<summary>.
 *
 * Zero JavaScript, keyboard operable and screen-reader understood for free.
 * A reference site builds its accordion from <div>s with hand-rolled ARIA;
 * the native element is both more robust and less code.
 *
 * No FAQPage structured data is emitted: Google retired FAQ rich results on
 * 2026-05-07. Visible, well-structured Q&A in the HTML is what now serves
 * patients, crawlers and AI extraction alike — and it is exactly the
 * factual/educational content Israeli advertising regulations permit.
 */
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import Icon from '../primitives/Icon.astro';
import EditControl from '../editor/EditControl.astro';

interface Props {
  locale: Locale;
  items: Array<{ q: string; a: string }>;
  title?: string;
  headingLevel?: 'h1' | 'h2';
  id?: string;
}

const { locale, items, title, headingLevel = 'h2', id = 'faq' } = Astro.props;
const t = useTranslations(locale);
const Heading = headingLevel;
---

<section class="section" aria-labelledby={`${id}-heading`}>
  <div class="shell max-w-3xl">
    <EditControl kind="faq" locale={locale} />
    <p class="eyebrow">{t('faq.title')}</p>
    <Heading id={`${id}-heading`} class="mt-2">{title ?? t('faq.title')}</Heading>

    <div class="reveal reveal-soft mt-8 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
      {
        items.map((item) => (
          <details class="group">
            <summary
              class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-[var(--text-base)] font-semibold text-[var(--color-ink)] transition-colors duration-[var(--dur-fast)] hover:text-[var(--color-ink-deep)] [&::-webkit-details-marker]:hidden"
            >
              <span>{item.q}</span>
              <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-[var(--color-haze)] transition-transform duration-[var(--dur-base)] ease-[var(--ease-out)] group-open:rotate-45">
                <Icon name="plus" size={16} stroke={2} />
              </span>
            </summary>
            <p class="pb-5 text-[var(--text-base)] leading-relaxed text-[var(--color-muted)]">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
