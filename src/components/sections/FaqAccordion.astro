---
/**
 * FAQ accordion — native <details>/<summary>.
 *
 * Zero JavaScript, keyboard operable and screen-reader understood for free.
 * A reference site builds its accordion from <div>s with hand-rolled ARIA;
 * the native element is both more robust and less code.
 *
 * No FAQPage structured data is emitted: Google retired FAQ rich results on
 * 2026-05-07. Visible, well-structured Q&A in the HTML is what now serves
 * patients, crawlers and AI extraction alike — and it is exactly the
 * factual/educational content Israeli advertising regulations permit.
 */
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import Icon from '../primitives/Icon.astro';
import EditControl from '../editor/EditControl.astro';

interface Props {
  locale: Locale;
  items: Array<{ q: string; a: string }>;
  title?: string;
  headingLevel?: 'h1' | 'h2';
  id?: string;
}

const { locale, items, title, headingLevel = 'h2', id = 'faq' } = Astro.props;
const t = useTranslations(locale);
const Heading = headingLevel;
---

<section class="section" aria-labelledby={`${id}-heading`}>
  <div class="shell max-w-3xl">
    <EditControl kind="faq" locale={locale} />
    <p class="eyebrow">{t('faq.title')}</p>
    <Heading id={`${id}-heading`} class="mt-2">{title ?? t('faq.title')}</Heading>

    <div class="card reveal reveal-soft mt-8 overflow-hidden" data-faq-group>
      {
        items.map((item) => (
          <details class="group">
            <summary
              class="faq-row flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-5 text-[length:var(--text-base)] font-semibold text-[var(--color-ink)] transition-colors duration-[var(--dur-fast)] sm:px-6 [&::-webkit-details-marker]:hidden"
            >
              <span>{item.q}</span>
              <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-[color-mix(in_srgb,var(--color-ink)_8%,transparent)] text-[var(--color-ink)] transition-transform duration-[var(--dur-slow)] ease-[var(--ease-ios)] group-open:rotate-45">
                <Icon name="plus" size={16} stroke={2} />
              </span>
            </summary>
            <p class="px-5 pb-5 text-[length:var(--text-base)] leading-relaxed text-[var(--color-muted)] sm:px-6">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Inset grouped list: hairline separators that stop short of the edges. */
  [data-faq-group] > details + details {
    border-block-start: 1px solid transparent;
    background-image: linear-gradient(var(--color-line), var(--color-line));
    background-size: calc(100% - 2.5rem) 1px;
    background-position: center top;
    background-repeat: no-repeat;
  }
  .faq-row:hover {
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }
</style>
