---
/**
 * Patient feedback — a LINK OUT to Google, never reviews on this site.
 *
 * ── WHY THIS IS NOT A TESTIMONIALS SECTION (ADR 0005) ─────────────────────
 * Israeli law (תקנות רופאי השיניים (פרסומת אסורה), תשס"ט-2009) prohibits a
 * dentist from advertising using a patient's name, image, likeness or any
 * identifying information — reportedly even with the patient's consent.
 * Violation is criminal, and outsourcing the copy does not shift liability.
 *
 * Google separately rules review markup on the reviewed entity's own site
 * ineligible for star rich results, so republishing would not even render.
 *
 * Both roads lead to the same place: reviews belong ON GOOGLE, where the
 * patient publishes them themselves. This component points there. It carries
 * no names, no quotes and no AggregateRating markup — it is navigation, not
 * advertising.
 *
 * DO NOT "improve" this by pulling review text in. That is the change this
 * file exists to prevent.
 *
 * ── THE AGGREGATE ─────────────────────────────────────────────────────────
 * The rating figure and review count ARE shown once the owner supplies them,
 * because they are Google's published statistic about the BUSINESS, not any
 * patient's identity or words. The attribution line names Google as the
 * source so the number is never mistaken for a claim the clinic made about
 * itself.
 *
 * Deliberately NOT mirrored into structured data: Google treats review
 * markup a business controls about itself as ineligible and, at worst, a
 * manual-action risk. See src/lib/schema.ts.
 *
 * ── THREE STATES ──────────────────────────────────────────────────────────
 *   no profile URL          → nothing renders at all
 *   profile, no rating yet  → the link-out card, exactly as before
 *   profile + rating        → the link-out card led by the aggregate
 *
 * Every number here must be copied from the live profile. An estimated
 * rating is a fabricated review by another route.
 */
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { clinic, hasGoogleProfile, hasGoogleRating } from '../../data/clinic';
import Icon from '../primitives/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const showRating = hasGoogleRating();
const value = clinic.googleRating.value ?? 0;
const count = clinic.googleRating.count ?? 0;

/**
 * Percentage of the five-star row that is filled. The overlay is clipped to
 * this width, so 4.9 shows as very nearly five stars rather than rounding to
 * a whole one — rounding up would overstate the rating.
 */
const fillPercent = Math.max(0, Math.min(100, (value / 5) * 100)).toFixed(2);

/** Formatted in the visitor's own locale: 4.9 in Hebrew, ٤٫٩ in Arabic. */
const formatter = new Intl.NumberFormat(locale, {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
const displayValue = formatter.format(value);
const displayCount = new Intl.NumberFormat(locale).format(count);

const star =
  '<path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.6 9.7l5.8-.8L12 3.6Z"/>';
const starRow = `<svg viewBox="0 0 120 24" width="120" height="24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">${[0, 24, 48, 72, 96]
  .map((x) => `<g transform="translate(${x} 0)">${star}</g>`)
  .join('')}</svg>`;
---

{
  hasGoogleProfile() && (
    <section class="section" aria-labelledby="feedback-heading">
      <div class="shell">
        <div class="reveal reveal-soft mx-auto max-w-2xl rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-mist)] px-6 py-10 text-center sm:px-10">
          {showRating ? (
            <div>
              {/* The number is the subject. The stars restate it visually and
                  are hidden from assistive tech, which reads the number. */}
              <p class="u-ltr flex items-center justify-center gap-3">
                <span class="font-[var(--font-display)] text-[var(--text-3xl)] leading-none font-semibold text-[var(--color-ink)]">
                  {displayValue}
                </span>
                <span class="relative inline-block h-6 w-[120px]" aria-hidden="true">
                  {/* Empty row underneath, filled row clipped on top. */}
                  <span class="absolute inset-0 text-[var(--color-line-strong)]" set:html={starRow} />
                  <span
                    class="absolute inset-y-0 start-0 overflow-hidden text-[var(--color-signal)]"
                    style={`width:${fillPercent}%`}
                    set:html={starRow}
                  />
                </span>
              </p>

              {/* The accessible statement of the same fact. */}
              <p class="sr-only">{`${t('feedback.ratingLabel')}: ${displayValue} / 5`}</p>

              <p class="mt-3 text-[var(--text-sm)] text-[var(--color-muted)]">
                {t('feedback.basedOn').replace('{n}', displayCount)}
              </p>
            </div>
          ) : (
            <span class="mx-auto flex size-12 items-center justify-center rounded-[var(--radius-btn)] bg-[var(--color-haze)] text-[var(--color-ink)]">
              <Icon name="check" size={24} />
            </span>
          )}

          <h2 id="feedback-heading" class="mt-5 text-[var(--text-xl)]">{t('feedback.title')}</h2>

          <p class="mx-auto mt-3 max-w-lg leading-relaxed text-[var(--color-muted)]">
            {t('feedback.body')}
          </p>

          <p class="mt-6">
            <a
              href={clinic.social.googleBusiness}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[var(--radius-btn)] border border-[var(--color-line-strong)] bg-[var(--color-porcelain)] px-6 text-[var(--text-sm)] font-semibold text-[var(--color-ink)] no-underline transition-[border-color,transform] duration-[var(--dur-fast)] ease-[var(--ease-out)] hover:border-[var(--color-ink)] active:translate-y-px"
            >
              {t('feedback.cta')}
              <Icon name="chevron" size={16} />
            </a>
          </p>
        </div>
      </div>
    </section>
  )
}
