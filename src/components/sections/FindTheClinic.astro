---
/**
 * "How to reach the clinic" — location, hours and navigation.
 *
 * ── WHY THE MAP IS NOT EMBEDDED ───────────────────────────────────────────
 * This site contacts ZERO third parties on load. That is not incidental —
 * the whole Amendment 13 privacy posture, and the ability to ship without a
 * cookie banner, rests on it. A Google Maps iframe would contact Google, set
 * cookies and add several hundred KB before the visitor asked for a map.
 *
 * So navigation is offered as LINKS first. The visitor taps and their own
 * map app opens — which is what someone actually driving to a clinic wants.
 * An interactive map is available below them as a CLICK-TO-LOAD FACADE
 * (MapFacade.astro): nothing reaches Google until the visitor presses a
 * button that says so.
 *
 * ── WHY EVERYTHING IS GUARDED ─────────────────────────────────────────────
 * The owner supplied Street 1003 and the Waze destination on 2026-09-21.
 * Guards remain for any future removal of location data. Navigation links
 * remain available even if the interactive Google map cannot load.
 */
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import {
  clinic,
  telUrl,
  whatsappUrl,
  hasAddress,
  hasHours,
  mapsUrl,
  wazeUrl,
} from '../../data/clinic';
import Icon from '../primitives/Icon.astro';
import MapFacade from './MapFacade.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const maps = mapsUrl(locale);
const waze = wazeUrl();
const canNavigate = Boolean(maps || waze);

const waMessage = {
  he: 'שלום, אשמח לקבל את הכתובת המדויקת של המרפאה.',
  ar: 'مرحبًا، أودّ الحصول على العنوان الدقيق للعيادة.',
  en: 'Hello, could you send me the exact address of the clinic?',
}[locale];

const dayNames: Record<Locale, Record<string, string>> = {
  he: { Sunday: 'ראשון', Monday: 'שני', Tuesday: 'שלישי', Wednesday: 'רביעי', Thursday: 'חמישי', Friday: 'שישי', Saturday: 'שבת' },
  ar: { Sunday: 'الأحد', Monday: 'الإثنين', Tuesday: 'الثلاثاء', Wednesday: 'الأربعاء', Thursday: 'الخميس', Friday: 'الجمعة', Saturday: 'السبت' },
  en: { Sunday: 'Sunday', Monday: 'Monday', Tuesday: 'Tuesday', Wednesday: 'Wednesday', Thursday: 'Thursday', Friday: 'Friday', Saturday: 'Saturday' },
};

const actionClass =
  'inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[var(--radius-btn)] ' +
  'px-5 text-[var(--text-sm)] font-semibold no-underline ' +
  'transition-[background-color,border-color,transform] duration-[var(--dur-fast)] ' +
  'ease-[var(--ease-out)] active:translate-y-px';
---

<section class="section bg-[var(--color-mist)]" aria-labelledby="location-heading">
  <div class="shell">
    <div class="max-w-2xl">
      <h2 id="location-heading">{t('location.title')}</h2>
      <p class="mt-3 text-[var(--text-lg)] text-[var(--color-muted)]">{t('location.subtitle')}</p>
    </div>

    <div class="mt-10 grid overflow-hidden rounded-[var(--radius-media)] border border-[var(--color-line)] bg-[var(--color-porcelain)] lg:grid-cols-[0.85fr_1.15fr]">
      <!-- Details -->
      <div class="p-6 sm:p-10">
        <dl class="grid gap-6 sm:grid-cols-2">
          <div>
            <dt class="eyebrow">{t('contact.addressLabel')}</dt>
            <dd class="mt-1.5 flex items-start gap-2" style="margin-inline-start:0">
              <Icon name="map-pin" size={17} class="mt-1 shrink-0 text-[var(--color-signal)]" />
              <span>
                {hasAddress(locale) && <>{clinic.address.street[locale]}<br /></>}
                {clinic.address.locality[locale]}<br />
                <span class="text-[var(--color-muted)]">{clinic.address.region[locale]}</span>
              </span>
            </dd>
          </div>

          {
            hasHours() && (
              <div class="sm:col-span-2">
                <dt class="eyebrow">{t('contact.hoursLabel')}</dt>
                <dd class="mt-1.5" style="margin-inline-start:0">
                  <ul class="grid gap-1 sm:grid-cols-2" style="list-style:none;padding-inline-start:0;margin:0">
                    {clinic.hours.map((h) => (
                      <li class="flex justify-between gap-6 text-[var(--text-sm)]">
                        <span class="text-[var(--color-muted)]">{dayNames[locale][h.day]}</span>
                        <span class="u-ltr">{h.closed ? '—' : `${h.opens}–${h.closes}`}</span>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      <!-- Actions -->
      <div class="mt-8 border-t border-[var(--color-line)] pt-6">
        {
          canNavigate ? (
            <div class="flex flex-col gap-3">
              {maps && (
                <a
                  href={maps}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`${actionClass} bg-[var(--color-ink)] text-white hover:bg-[var(--color-ink-deep)]`}
                >
                  <Icon name="map-pin" size={18} />
                  {t('action.googleMaps')}
                </a>
              )}
              {waze && (
                <a
                  href={waze}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`${actionClass} border border-[var(--color-line-strong)] bg-[var(--color-porcelain)] text-[var(--color-ink)] hover:border-[var(--color-ink)]`}
                >
                  <Icon name="chevron" size={18} class="u-flip" />
                  {t('action.waze')}
                </a>
              )}
            </div>
          ) : (
            /* Address not yet verified — say so plainly and give the two
               channels that DO work, rather than guessing a location. */
            <div>
              <h3 class="text-[var(--text-base)] font-semibold">{t('location.pendingTitle')}</h3>
              <p class="mt-2 text-[var(--text-sm)] leading-relaxed text-[var(--color-muted)]">
                {t('location.pendingBody')}
              </p>
            </div>
          )
        }

        {!canNavigate && <div class="mt-4 flex flex-col gap-3">
          <a
            href={telUrl('landline')}
            class={`${actionClass} border border-[var(--color-line-strong)] bg-[var(--color-porcelain)] text-[var(--color-ink)] hover:border-[var(--color-ink)]`}
          >
            <Icon name="phone" size={18} />
            <span class="u-ltr">{clinic.phone.landline.display}</span>
          </a>
          <a
            href={whatsappUrl(waMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class={`${actionClass} bg-[var(--color-wa)] text-white hover:brightness-90`}
          >
            <Icon name="whatsapp" size={18} />
            {t('action.whatsapp')}
          </a>
        </div>}
      </div>
      </div>
      <MapFacade locale={locale} />
    </div>
  </div>
</section>
