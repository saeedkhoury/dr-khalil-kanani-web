---
/**
 * Clinic gallery — editorial grid + accessible lightbox.
 *
 * WHICH collection this renders is passed in by the caller as `kind`. It is
 * never inferred from the contents of an array. Inference is what would let a
 * treatment-result photograph silently become the clinic gallery the first
 * time somebody registered one — the separation has to be structural.
 * Work posts retain their full composition; social buttons link to clinic profiles.
 *
 * ── LAYOUT ────────────────────────────────────────────────────────────────
 * Treatment work uses equal tiles that preserve the full original image.
 * Other photography uses an editorial grid. Entries marked `feature` span two
 * columns and two rows, so the composition has a subject instead of being a
 * uniform contact sheet. Mobile: a single column, no carousel — a carousel
 * hides most of the content behind an interaction and needs its own
 * accessibility work for no gain at this size.
 *
 * ── LIGHTBOX ──────────────────────────────────────────────────────────────
 * Native <dialog>. Focus trap, Escape-to-close, inert background and focus
 * restore are all browser behaviour, so the only hand-written parts are
 * arrow-key navigation and swipe. Roughly 1.5KB of JS for the whole thing.
 */
import { Image, getImage } from 'astro:assets';
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { galleryFor, type GalleryKind } from '../../data/media';
import { clinic } from '../../data/clinic';
import { resolveImage } from '../../lib/images';
import Icon from '../primitives/Icon.astro';
import Button from '../primitives/Button.astro';
import EditControl from '../editor/EditControl.astro';

interface Props {
  locale: Locale;
  /** Which collection to render. Required: there is no sensible default. */
  kind: GalleryKind;
}
const { locale, kind } = Astro.props;
const t = useTranslations(locale);

// Drop entries whose file is missing rather than rendering a broken image.
const assets = galleryFor(kind);
const workGallery = kind === 'work';
const illustrative = kind === 'illustrations';
const resolvedItems = assets
  .map((asset) => ({ asset, resolved: resolveImage(asset.file) }))
  .filter((i): i is { asset: (typeof assets)[number]; resolved: NonNullable<ReturnType<typeof resolveImage>> } =>
    i.resolved !== undefined,
  );
const items = await Promise.all(resolvedItems.map(async (item) => ({
  ...item,
  fullSize: await getImage({ src: item.resolved, width: Math.min(1536, item.resolved.width), format: item.resolved.format === 'svg' ? 'svg' : 'webp', quality: 85 }),
})));

// ── Edit Mode ─────────────────────────────────────────────────────────────
// The clinic gallery ends with an Edit tile, so the doctor manages the gallery
// he is looking at. In Edit Mode the section renders even when empty, or
// there would be nothing to put the tile at the end of. Treatment work stays
// developer-managed (patient-result media), so its strip ends with a note
// saying so instead of a control. None of this exists in the public build.
const editing = process.env.VISUAL_CMS === '1';
const editableClinic = editing && kind === 'clinic';
const WORK_NOTE = {
  he: 'תמונות הטיפולים מנוהלות על ידי המפתח ואינן ניתנות לעריכה כאן.',
  ar: 'صور العلاجات يديرها المطوّر ولا يمكن تعديلها هنا.',
  en: 'Treatment photos are managed by the developer and cannot be edited here.',
}[locale];
const EMPTY_NOTE = {
  he: 'עדיין אין תמונות מרפאה מוצגות באתר. הגלריה תופיע למטופלים כשתוצג בה תמונה ראשונה.',
  ar: 'لا توجد بعد صور معروضة للعيادة. سيظهر المعرض للزوار عند عرض أول صورة.',
  en: 'No clinic photos are shown yet. Visitors will see this gallery once the first photo is shown.',
}[locale];
---

{
  (items.length > 0 || editableClinic) && (
    <section class="section-lg bg-[var(--color-mist)]" aria-labelledby="gallery-heading" data-gallery-kind={workGallery ? 'work' : illustrative ? 'illustrations' : 'clinic'} data-visual-only={items.length === 0 ? '' : undefined}>
      <div class="shell">
        <div class="max-w-2xl">
          <p class="eyebrow">{t(workGallery ? 'gallery.workEyebrow' : illustrative ? 'gallery.artEyebrow' : 'gallery.eyebrow')}</p>
          <h2 id="gallery-heading" class="mt-2">{t(workGallery ? 'gallery.workTitle' : illustrative ? 'gallery.artTitle' : 'gallery.title')}</h2>
          <p class="mt-3 text-[var(--text-lg)] text-[var(--color-muted)]">{t(workGallery ? 'gallery.workIntro' : illustrative ? 'gallery.artIntro' : 'gallery.intro')}</p>
          {workGallery && <div class="mt-5 flex flex-wrap gap-3" data-gallery-social>
            <Button href={clinic.social.instagram} variant="outline" icon="instagram" target="_blank" rel="noopener noreferrer"><span class="u-ltr">Instagram</span></Button>
            {clinic.social.facebook && <Button href={clinic.social.facebook} variant="outline" icon="facebook" target="_blank" rel="noopener noreferrer"><span class="u-ltr">Facebook</span></Button>}
          </div>}
        </div>

        {/* ── WHY A HORIZONTAL SCROLLER FOR TREATMENT WORK ────────────────
            These images are a mix of square (1254x1254) and tall 9:16 posts,
            and every one must be shown WHOLE: `object-cover` would crop away
            the clinic's own branding and the before/after labels that ADR 0009
            requires be visible.

            A film-strip solves what a grid cannot. Each tile is a fixed HEIGHT
            with its width derived from its own aspect ratio, so nothing is
            cropped and nothing is letterboxed — the strip simply has tiles of
            differing widths, which reads as intentional rather than ragged.

            Built on native `overflow-x: auto` + scroll-snap rather than a
            carousel library: touch swipe, momentum, trackpad, and keyboard
            scrolling all come free and correct, including in RTL, where the
            strip starts at the right because `direction` already governs
            inline scrolling. The arrow buttons are a convenience on top, not
            the mechanism. */}
        {workGallery && (
          <div class="mt-10 flex items-center justify-between gap-4">
            <p class="text-[var(--text-sm)] text-[var(--color-muted)]">{t('gallery.scrollHint')}</p>
            {/* Convenience only — the strip is fully usable without these. */}
            <div class="flex gap-2">
              <button
                type="button"
                data-strip-prev
                aria-controls="work-strip"
                aria-label={t('gallery.previous')}
                class="flex size-11 cursor-pointer items-center justify-center rounded-full border border-[var(--color-line-strong)] bg-[var(--color-porcelain)] text-[var(--color-ink)] transition-colors duration-[var(--dur-fast)] hover:bg-[var(--color-mist)] disabled:opacity-40"
              >
                <Icon name="chevron" size={18} class="u-flip rotate-180" />
              </button>
              <button
                type="button"
                data-strip-next
                aria-controls="work-strip"
                aria-label={t('gallery.next')}
                class="flex size-11 cursor-pointer items-center justify-center rounded-full border border-[var(--color-line-strong)] bg-[var(--color-porcelain)] text-[var(--color-ink)] transition-colors duration-[var(--dur-fast)] hover:bg-[var(--color-mist)] disabled:opacity-40"
              >
                <Icon name="chevron" size={18} class="u-flip" />
              </button>
            </div>
          </div>
        )}

        {/* The scroll container is a DIV, not the <ul>. Putting role="region"
            on the list itself overrides its implicit `list` role, which
            orphans every <li> — axe reports "listitem" violations and screen
            readers stop announcing "list, 12 items". For the non-work
            galleries this wrapper is display:contents, so it changes nothing. */}
        <div
          id={workGallery ? 'work-strip' : undefined}
          role={workGallery ? 'region' : undefined}
          aria-label={workGallery ? t('gallery.workTitle') : undefined}
          class:list={[
            workGallery
              ? 'work-strip mt-5 snap-x snap-mandatory overflow-x-auto overscroll-x-contain pb-3'
              : 'contents',
          ]}
        >
        <ul
          class:list={[
            workGallery
              ? 'flex gap-4'
              : 'mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:auto-rows-[15rem]',
          ]}
          style="list-style:none;padding-inline-start:0;margin-block-end:0"
        >
          {items.map(({ asset, resolved }, i) => (
            <li
              class:list={[
                'reveal',
                workGallery ? 'shrink-0 snap-start' : '',
                !workGallery && asset.feature ? 'sm:col-span-2 lg:row-span-2' : '',
              ]}
              style={`--i:${i % 3}`}
            >
              <button
                type="button"
                class:list={['group relative block w-full cursor-pointer overflow-hidden rounded-[var(--radius-media)] border border-[var(--color-line)] bg-[var(--color-porcelain)] p-0', !workGallery && 'h-full']}
                data-gallery-open={i}
                aria-label={asset.alt[locale]}
              >
                <Image
                  src={resolved}
                  alt={asset.alt[locale]}
                  widths={[400, 800, 1200]}
                  sizes={asset.feature ? '(min-width: 1024px) 66vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding={i < 3 ? 'sync' : 'async'}
                  style={workGallery ? `aspect-ratio:${asset.width} / ${asset.height}` : undefined}
                  class:list={[
                    'transition-opacity duration-[var(--dur-base)] group-hover:opacity-90',
                    /* Fixed height, width follows the aspect ratio. `contain`
                       stays as a safety net if a registered dimension is ever
                       wrong — a wrong number should letterbox, never crop. */
                    workGallery ? 'block h-[18rem] w-auto object-contain sm:h-[22rem]' : 'size-full object-cover',
                  ]}
                />
                {asset.caption && (
                  <span class:list={[
                    'pointer-events-none p-4 text-start text-[var(--text-sm)] font-semibold',
                    workGallery ? 'block border-t border-[var(--color-line)] text-[var(--color-ink)]' : 'media-scrim absolute inset-x-0 inset-be-0 text-white',
                  ]}>
                    {asset.caption[locale]}
                  </span>
                )}
              </button>
            </li>
          ))}
          {editableClinic && (
            <li class="visual-gallery-edit" data-visual-only>
              <EditControl kind="photos" focus="gallery" locale={locale} />
            </li>
          )}
          {editing && workGallery && (
            <li class="visual-work-note shrink-0" data-visual-only>{WORK_NOTE}</li>
          )}
        </ul>
        {editableClinic && items.length === 0 && <p class="visual-gallery-empty" data-visual-only>{EMPTY_NOTE}</p>}
        </div>
      </div>

      {/* ---- Lightbox ---- */}
      <dialog
        id="gallery-lightbox"
        class="m-auto max-h-[92dvh] w-[min(92vw,72rem)] rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-porcelain)] p-0 backdrop:bg-[color-mix(in_srgb,var(--color-ink-deep)_78%,transparent)]"
        aria-labelledby="lightbox-caption"
      >
        <div class="relative">
          <div class="flex items-center justify-between gap-4 border-b border-[var(--color-line)] p-3">
            <p
              id="lightbox-caption"
              class="min-w-0 flex-1 truncate text-[var(--text-sm)] text-[var(--color-muted)]"
            ></p>
            <button
              type="button"
              data-gallery-close
              class="flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-[var(--radius-btn)] text-[var(--color-ink)] transition-colors duration-[var(--dur-fast)] hover:bg-[var(--color-mist)]"
              aria-label={t('gallery.close')}
            >
              <Icon name="close" size={22} />
            </button>
          </div>

          <div class="flex items-center justify-center bg-[var(--color-haze)] p-2">
            {/* Swapped by script; alt is set alongside src so it never lies. */}
            <img id="lightbox-image" src="" alt="" class="w-auto max-h-[65dvh] rounded-[var(--radius-field)]" />
          </div>

          <div class="flex items-center justify-between gap-3 border-t border-[var(--color-line)] p-3">
            <button
              type="button"
              data-gallery-prev
              class="flex min-h-11 cursor-pointer items-center gap-2 rounded-[var(--radius-btn)] px-4 text-[var(--text-sm)] font-semibold text-[var(--color-ink)] transition-colors duration-[var(--dur-fast)] hover:bg-[var(--color-mist)]"
            >
              <Icon name="chevron" size={18} class="u-flip rotate-180" />
              {t('gallery.previous')}
            </button>
            <p id="lightbox-position" class="u-ltr text-[var(--text-sm)] text-[var(--color-muted)]"></p>
            <button
              type="button"
              data-gallery-next
              class="flex min-h-11 cursor-pointer items-center gap-2 rounded-[var(--radius-btn)] px-4 text-[var(--text-sm)] font-semibold text-[var(--color-ink)] transition-colors duration-[var(--dur-fast)] hover:bg-[var(--color-mist)]"
            >
              {t('gallery.next')}
              <Icon name="chevron" size={18} />
            </button>
          </div>
        </div>
      </dialog>

      {/* Source data for the lightbox. Kept as JSON rather than data-attributes
          on every tile so the markup stays clean and alt text is not duplicated. */}
      <script
        type="application/json"
        id="gallery-data"
        set:html={JSON.stringify(
          items.map(({ asset, fullSize }) => ({
            src: fullSize.src,
            alt: asset.alt[locale],
            caption: asset.caption?.[locale] ?? '',
          })),
        ).replace(/</g, '\\u003c')}
      />

      {/* ── WHY is:inline ────────────────────────────────────────────────
          A normal Astro <script> is hoisted into the page bundle whenever
          this component is part of the page — even when it renders nothing.
          With no photography registered that shipped ~1.5KB of lightbox
          code to every visitor on every page, to drive a dialog that did
          not exist. Inline keeps the script inside the conditional, so it
          exists only when there are actually images to open. Plain JS, not
          TypeScript: inline scripts are passed through untransformed. */}
      <script is:inline>
        (() => {
          const strip = document.getElementById('work-strip');
          if (!strip) return;
          const prev = document.querySelector('[data-strip-prev]');
          const next = document.querySelector('[data-strip-next]');

          // In RTL the browser already scrolls the inline axis the right way,
          // but scrollLeft is NEGATIVE in Chrome and Firefox. Working from the
          // sign of scrollLeft rather than assuming a direction keeps one code
          // path correct in Hebrew, Arabic and English.
          const rtl = () => getComputedStyle(strip).direction === 'rtl';
          const step = () => Math.max(240, strip.clientWidth * 0.8);

          const scrollByStep = (forward) => {
            const delta = step() * (forward ? 1 : -1) * (rtl() ? -1 : 1);
            const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
            strip.scrollBy({ left: delta, behavior: reduce ? 'auto' : 'smooth' });
          };

          prev?.addEventListener('click', () => scrollByStep(false));
          next?.addEventListener('click', () => scrollByStep(true));

          // Disable an arrow at the end of travel, so the control tells the
          // truth about whether there is anything left to see.
          const sync = () => {
            const max = strip.scrollWidth - strip.clientWidth;
            const pos = Math.abs(strip.scrollLeft);
            const atStart = pos <= 2;
            const atEnd = pos >= max - 2;
            if (prev) prev.disabled = atStart;
            if (next) next.disabled = atEnd || max <= 2;
          };
          strip.addEventListener('scroll', sync, { passive: true });
          addEventListener('resize', sync);
          sync();
        })();
      </script>

      <script is:inline>
        (() => {
          const dialog = document.getElementById('gallery-lightbox');
          const dataEl = document.getElementById('gallery-data');
          if (!dialog || !dataEl) return;

          const slides = JSON.parse(dataEl.textContent || '[]');
          const img = document.getElementById('lightbox-image');
          const caption = document.getElementById('lightbox-caption');
          const position = document.getElementById('lightbox-position');
          let index = 0;

          const isRtl = () => document.documentElement.dir === 'rtl';

          function show(i) {
            index = (i + slides.length) % slides.length;
            const slide = slides[index];
            // src and alt are set together — an image whose alt describes a
            // different picture is worse than no alt at all.
            img.src = slide.src;
            img.alt = slide.alt;
            caption.textContent = slide.caption || slide.alt;
            position.textContent = `${index + 1} / ${slides.length}`;
          }

          document.querySelectorAll('[data-gallery-open]').forEach((btn) => {
            btn.addEventListener('click', () => {
              show(Number(btn.dataset.galleryOpen));
              dialog.showModal();
            });
          });

          dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
          dialog.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(index - 1));
          dialog.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(index + 1));

          // Arrow keys follow VISUAL direction, so in RTL the left arrow advances.
          dialog.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
            const forward = isRtl() ? event.key === 'ArrowLeft' : event.key === 'ArrowRight';
            show(index + (forward ? 1 : -1));
            event.preventDefault();
          });

          // Swipe, same direction logic.
          let startX = 0;
          dialog.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX; }, { passive: true });
          dialog.addEventListener('touchend', (e) => {
            const dx = e.changedTouches[0].clientX - startX;
            if (Math.abs(dx) < 48) return;
            const forward = isRtl() ? dx > 0 : dx < 0;
            show(index + (forward ? 1 : -1));
          }, { passive: true });

          // Clicking the backdrop closes, matching the expectation set by the dim.
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
        })();
      </script>

    </section>
  )
}
