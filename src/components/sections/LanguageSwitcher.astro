---
/**
 * Language switcher.
 *
 * Requirements this satisfies (docs/I18N.md):
 *  • Real <a href> elements with static URLs, present in the server HTML.
 *    Google needs to crawl every language; a <select onchange> or a JS
 *    cookie-and-reload would hide two of the three languages entirely.
 *  • Links page-to-EQUIVALENT-page, not everything to the other homepages —
 *    this is what preserves the visitor's logical location.
 *  • Each language labelled in its own script. Never flag icons: Arabic has
 *    no flag, and an Israeli flag for Hebrew is needlessly loaded in a
 *    mixed region.
 *  • No automatic redirect by IP or Accept-Language anywhere on the site.
 */
import { alternatesFor, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import Icon from '../primitives/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const alternates = alternatesFor(Astro.url.pathname);
const currentMeta = alternates.find((a) => a.locale === locale)!;
---

<details class="group relative">
  <summary
    class="flex min-h-[44px] cursor-pointer list-none items-center gap-1.5 rounded-[var(--radius-btn)] border border-[var(--color-line-strong)] px-3 text-[var(--text-sm)] font-semibold text-[var(--color-ink)] transition-colors duration-[var(--dur-fast)] hover:bg-[var(--color-mist)] [&::-webkit-details-marker]:hidden"
    aria-label={`${t('a11y.languageSwitcher')} — ${t('a11y.currentLanguage')}: ${currentMeta.meta.label}`}
  >
    <Icon name="globe" size={18} />
    <span>{currentMeta.meta.label}</span>
  </summary>

  <ul
    class="absolute z-50 mt-2 min-w-[10rem] list-none rounded-[var(--radius-card)] border border-[var(--color-line)] bg-[var(--color-porcelain)] p-1.5 shadow-[0_18px_44px_-24px_rgba(12,82,131,0.45)]"
    style="inset-inline-end:0; margin-block-start:0.5rem; padding-inline-start:0.375rem"
  >
    {
      alternates.map((alt) => (
        <li>
          <a
            href={alt.href}
            hreflang={alt.locale}
            lang={alt.locale}
            dir={alt.meta.dir}
            aria-current={alt.locale === locale ? 'true' : undefined}
            class:list={[
              'flex min-h-[44px] items-center rounded-[var(--radius-btn)] px-3 text-[var(--text-sm)] no-underline',
              alt.locale === locale
                ? 'bg-[var(--color-mist)] font-semibold text-[var(--color-ink)]'
                : 'text-[var(--color-body)] hover:bg-[var(--color-mist)]',
            ]}
          >
            {alt.meta.label}
          </a>
        </li>
      ))
    }
  </ul>
</details>
