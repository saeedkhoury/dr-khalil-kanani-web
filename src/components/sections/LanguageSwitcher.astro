---
/**
 * Language switcher.
 *
 * Requirements this satisfies (docs/I18N.md):
 *  • Real <a href> elements with static URLs, present in the server HTML.
 *    Google needs to crawl every language; a <select onchange> or a JS
 *    cookie-and-reload would hide two of the three languages entirely.
 *  • Links page-to-EQUIVALENT-page, not everything to the other homepages —
 *    this is what preserves the visitor's logical location.
 *  • Each language labelled in its own script. Never flag icons: Arabic has
 *    no flag, and an Israeli flag for Hebrew is needlessly loaded in a
 *    mixed region.
 *  • No automatic redirect by IP or Accept-Language anywhere on the site.
 */
import { alternatesFor, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import Icon from '../primitives/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const alternates = alternatesFor(Astro.url.pathname);
const currentMeta = alternates.find((a) => a.locale === locale)!;
---

<details class="lang-switcher group relative">
  <summary
    class="glass glass-capsule press flex min-h-[44px] cursor-pointer list-none items-center gap-1.5 px-3.5 text-[length:var(--text-sm)] font-semibold text-[var(--color-ink)] [&::-webkit-details-marker]:hidden"
    aria-label={`${t('a11y.languageSwitcher')} — ${t('a11y.currentLanguage')}: ${currentMeta.meta.label}`}
  >
    <Icon name="globe" size={18} />
    <span>{currentMeta.meta.label}</span>
  </summary>

  <ul
    class="glass glass-sheet lang-menu absolute z-50 min-w-[11rem] list-none p-1.5"
    style="inset-inline-end:0; margin-block-start:0.625rem; padding-inline-start:0.375rem"
  >
    {
      alternates.map((alt) => (
        <li>
          <a
            href={alt.href}
            hreflang={alt.locale}
            lang={alt.locale}
            dir={alt.meta.dir}
            aria-current={alt.locale === locale ? 'true' : undefined}
            class:list={[
              'press flex min-h-[44px] items-center justify-between gap-3 rounded-[14px] px-3.5 text-[length:var(--text-sm)] no-underline',
              alt.locale === locale
                ? 'bg-white font-semibold text-[var(--color-ink)] shadow-[var(--lens-shadow)]'
                : 'text-[var(--color-body)] hover:bg-[color-mix(in_srgb,var(--color-ink)_7%,transparent)]',
            ]}
          >
            <span>{alt.meta.label}</span>
            {alt.locale === locale && <Icon name="check" size={16} />}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  /* The menu grows out of its capsule (spatial consistency). */
  .lang-switcher[open] > .lang-menu {
    transform-origin: top right;
    animation: lang-in var(--dur-base) var(--ease-ios) both;
  }
  :global(html[dir='rtl']) .lang-switcher[open] > .lang-menu {
    transform-origin: top left;
  }
  @keyframes lang-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }
</style>
