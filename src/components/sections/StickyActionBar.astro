---
/**
 * Sticky mobile action bar — Call · WhatsApp · Directions.
 *
 * Present from first paint, not after a delay. Neither reference clinic
 * studied during discovery had one: on one, the first contact affordance sat
 * at 93% scroll depth on a 3,200px page, and a floating back-to-top button
 * physically covered the phone number.
 *
 * `body { padding-block-end: var(--actionbar-h) }` in global.css reserves
 * space so this bar can never obscure the footer.
 *
 * Directions is rendered only once a verified address exists — a wrong map
 * link is worse than none, and one reference site sends patients to the
 * wrong street on every page.
 */
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { clinic, telUrl, whatsappUrl, hasAddress } from '../../data/clinic';
import Icon from '../primitives/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const waMessage = {
  he: 'שלום, אשמח לקבוע תור במרפאה.',
  ar: 'مرحبًا، أودّ حجز موعد في العيادة.',
  en: 'Hello, I would like to request an appointment.',
}[locale];

const showDirections = hasAddress(locale);
const mapsQuery = encodeURIComponent(
  `${clinic.address.street[locale]} ${clinic.address.locality[locale]}`.trim(),
);

// A floating Liquid Glass capsule, like an iOS tab bar: it hovers above the
// content with a margin on every side instead of a full-width slab.
const itemClass =
  'press flex min-h-[52px] flex-1 flex-col items-center justify-center gap-0.5 rounded-full no-underline ' +
  'text-[length:var(--text-xs)] font-semibold hover:bg-[color-mix(in_srgb,var(--color-ink)_7%,transparent)]';
---

<div
  data-action-bar
  class="pointer-events-none fixed inset-x-0 inset-be-0 z-50 md:hidden"
  style="padding-inline: 0.75rem; padding-block-end: calc(0.5rem + env(safe-area-inset-bottom))"
>
  <nav class="glass glass-capsule pointer-events-auto flex items-stretch gap-1 p-1" aria-label={t('action.bookAppointment')}>
    <a href={telUrl('landline')} class={`${itemClass} text-[var(--color-ink)]`}>
      <Icon name="phone" size={21} />
      <span>{t('action.call')}</span>
    </a>

    <a
      href={whatsappUrl(waMessage)}
      target="_blank"
      rel="noopener noreferrer"
      class={`${itemClass} text-[var(--color-wa)]`}
    >
      <Icon name="whatsapp" size={21} />
      <span>{t('action.whatsapp')}</span>
    </a>

    {
      showDirections && (
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`}
          target="_blank"
          rel="noopener noreferrer"
          class={`${itemClass} text-[var(--color-ink)]`}
        >
          <Icon name="map-pin" size={21} />
          <span>{t('action.directions')}</span>
        </a>
      )
    }
  </nav>
</div>
